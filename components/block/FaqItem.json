{
  "component": {
    "structure": {
      "type": "node",
      "tag": "div",
      "label": "Item",
      "style": {
        "base": {
          "borderBottom": "1px solid",
          "borderColor": "var(--border)"
        },
        "tablet": {},
        "mobile": {}
      },
      "attributes": {
        "class": "{{isOpen ? \"is-open\" : \"\"}}",
        "fade": "{{fade}}"
      },
      "children": [
        {
          "type": "node",
          "tag": "dt",
          "label": "question",
          "style": {
            "base": {
              "padding": "20px 0 8px",
              "fontWeight": "600",
              "cursor": "pointer",
              "opacity": "0.6",
              "transition": "opacity .2s",
              "display": "flex",
              "alignItems": "center",
              "justifyContent": "space-between",
              "gap": "16px"
            },
            "tablet": {},
            "mobile": {}
          },
          "interactiveStyles": [
            {
              "name": "on hover",
              "postfix": ":hover",
              "style": {
                "base": {
                  "opacity": "1"
                }
              }
            },
            {
              "name": "is open",
              "prefix": ".is-open ",
              "style": {
                "base": {
                  "opacity": "1"
                }
              }
            }
          ],
          "attributes": {
            "data-el": "question"
          },
          "children": [
            "",
            {
              "type": "node",
              "tag": "div",
              "style": {
                "base": {
                  "flex": "1",
                  "minWidth": "0",
                  "marginBottom": "calc(-1 * var(--h3-s))"
                }
              },
              "children": [
                {
                  "type": "component",
                  "component": "Heading",
                  "props": {
                    "text": "{{question}}",
                    "tag": "4",
                    "variant": "default",
                    "size": "3"
                  }
                }
              ]
            },
            {
              "type": "node",
              "tag": "span",
              "label": "icon",
              "style": {
                "base": {
                  "display": "flex",
                  "alignItems": "center",
                  "justifyContent": "center",
                  "flexShrink": "0",
                  "alignSelf": "center",
                  "transition": "transform 0.3s ease",
                  "marginBottom": "8px"
                },
                "tablet": {},
                "mobile": {}
              },
              "interactiveStyles": [
                {
                  "name": "is open",
                  "prefix": ".is-open ",
                  "style": {
                    "base": {
                      "transform": "rotate(180deg)"
                    }
                  }
                }
              ],
              "children": [
                {
                  "type": "component",
                  "component": "Icon",
                  "props": {
                    "icon": "chevron-down",
                    "size": 20
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "node",
          "tag": "dd",
          "label": "answer",
          "style": {
            "base": {
              "margin": "0",
              "maxWidth": "800px",
              "display": "grid",
              "gridTemplateRows": "0fr",
              "transition": "grid-template-rows 0.3s ease"
            },
            "tablet": {},
            "mobile": {}
          },
          "interactiveStyles": [
            {
              "name": "is open",
              "prefix": ".is-open ",
              "style": {
                "base": {
                  "gridTemplateRows": "1fr"
                }
              }
            }
          ],
          "attributes": {
            "data-el": "answer"
          },
          "children": [
            {
              "type": "node",
              "tag": "div",
              "style": {
                "base": {
                  "overflow": "hidden",
                  "minHeight": "0"
                }
              },
              "children": [
                {
                  "type": "node",
                  "tag": "div",
                  "style": {
                    "base": {
                      "paddingBottom": "30px"
                    }
                  },
                  "children": [
                    "",
                    {
                      "type": "component",
                      "component": "Text",
                      "props": {
                        "size": "default",
                        "text": "{{answer}} ",
                        "variant": "default"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "question": {
        "type": "string",
        "default": "Question?"
      },
      "answer": {
        "type": "rich-text",
        "default": "Answer goes here."
      },
      "isOpen": {
        "type": "boolean"
      },
      "fade": {
        "type": "string",
        "default": ""
      }
    }
  }
}