{
  "component": {
    "structure": {
      "type": "node",
      "tag": "a",
      "style": {
        "base": {
          "display": "grid",
          "gridTemplateColumns": "400px 1fr",
          "gap": "32px",
          "alignItems": "start",
          "paddingTop": "32px",
          "paddingBottom": "32px",
          "borderBottom": "1px solid var(--border-100)",
          "textDecoration": "none",
          "color": "inherit"
        },
        "tablet": {
          "gridTemplateColumns": "200px 1fr",
          "gap": "24px"
        },
        "mobile": {
          "gridTemplateColumns": "1fr",
          "gap": "16px"
        }
      },
      "interactiveStyles": [
        {
          "postfix": ":hover h2",
          "style": {
            "base": {
              "color": "var(--primary)"
            }
          }
        }
      ],
      "attributes": {
        "href": "{{href}}",
        "fade": "{{fade}}"
      },
      "children": [
        {
          "type": "component",
          "component": "Image",
          "props": {
            "image": "{{image}}",
            "alt": "{{title}}",
            "objectFit": "cover",
            "height": "100%",
            "border": true,
            "rounded": "medium"
          }
        },
        {
          "type": "node",
          "tag": "div",
          "style": {
            "base": {
              "display": "flex",
              "flexDirection": "column"
            },
            "tablet": {},
            "mobile": {}
          },
          "children": [
            {
              "type": "component",
              "component": "Text",
              "props": {
                "text": "{{date}}",
                "size": "small",
                "variant": "light"
              }
            },
            {
              "type": "component",
              "component": "Spacer",
              "props": {
                "size": "8"
              }
            },
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "{{title}}",
                "tag": "2",
                "size": "4"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "props": {
                "text": "{{excerpt}}",
                "variant": "light",
                "size": "default"
              }
            }
          ]
        }
      ]
    },
    "interface": {
      "href": {
        "type": "link",
        "default": "#"
      },
      "image": {
        "type": "string"
      },
      "title": {
        "type": "string",
        "default": "Post Title"
      },
      "date": {
        "type": "string",
        "default": ""
      },
      "excerpt": {
        "type": "string",
        "default": ""
      },
      "fade": {
        "type": "string",
        "default": ""
      }
    }
  }
}