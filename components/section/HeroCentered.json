{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}"
      },
      "children": [
        {
          "type": "component",
          "component": "Stack",
          "props": {
            "horizontal": "center"
          },
          "children": [
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "{{title}}",
                "tag": "1",
                "align": "center",
                "size": "1",
                "fade": "0"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "if": "{{text}}",
              "props": {
                "text": "{{text}}",
                "size": "large",
                "align": "center",
                "maxWidth": "540px",
                "variant": "light",
                "fade": "0.2"
              }
            },
            {
              "type": "component",
              "component": "ButtonList",
              "if": "{{buttonText}}",
              "props": {
                "fade": "0.4"
              },
              "children": [
                {
                  "type": "component",
                  "component": "Button",
                  "props": {
                    "text": "{{buttonText}}",
                    "link": "{{buttonLink}}"
                  }
                },
                {
                  "type": "component",
                  "component": "Button",
                  "if": "{{secondaryButtonText}}",
                  "props": {
                    "text": "{{secondaryButtonText}}",
                    "link": "{{secondaryButtonLink}}",
                    "variant": "secondary"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "title": {
        "type": "rich-text",
        "default": "Your website, <span>built visually</span>"
      },
      "text": {
        "type": "rich-text",
        "default": "Design and publish professional websites without writing code. Start with this template and make it yours in minutes."
      },
      "buttonText": {
        "type": "string",
        "default": "Start building"
      },
      "buttonLink": {
        "type": "link",
        "default": "#"
      },
      "secondaryButtonText": {
        "type": "string",
        "default": "View components"
      },
      "secondaryButtonLink": {
        "type": "link",
        "default": "#"
      },
      "theme": {
        "type": "select",
        "default": "light",
        "enumName": "theme"
      }
    }
  }
}