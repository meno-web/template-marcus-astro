{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}",
        "spaceTop": "default"
      },
      "children": [
        {
          "type": "component",
          "component": "SectionHeader",
          "props": {
            "isCenter": true,
            "maxWidth": "600px"
          },
          "children": [
            {
              "type": "component",
              "component": "Subtitle",
              "if": "{{subtitle}}",
              "props": {
                "text": "{{subtitle}}",
                "align": "center",
                "fade": "0"
              }
            },
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "{{title}}",
                "maxWidth": "",
                "align": "center",
                "size": "2",
                "tag": "2",
                "fade": "0.2"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "if": "{{text}}",
              "props": {
                "text": "{{text}}",
                "size": "large",
                "align": "center",
                "maxWidth": "",
                "fade": "0.4"
              }
            }
          ]
        },
        {
          "type": "component",
          "component": "Grid",
          "props": {
            "columns": "3",
            "gap": "16",
            "fade": "0.4"
          },
          "children": [
            {
              "type": "list",
              "sourceType": "prop",
              "source": "{{items}}",
              "itemAs": "item",
              "children": [
                {
                  "type": "link",
                  "href": "{{item.link}}",
                  "style": {
                    "base": {
                      "display": "flex",
                      "textDecoration": "none",
                      "borderRadius": "16px",
                      "overflow": "hidden",
                      "backgroundColor": "var(--surface)",
                      "border": "1px solid var(--border-100)",
                      "transition": "transform 0.2s ease, box-shadow 0.2s ease",
                      "flexDirection": "column"
                    },
                    "tablet": {},
                    "mobile": {}
                  },
                  "interactiveStyles": [
                    {
                      "prefix": "",
                      "postfix": ":hover",
                      "style": {
                        "base": {
                          "transform": "translateY(-4px)"
                        }
                      }
                    }
                  ],
                  "children": [
                    {
                      "type": "node",
                      "tag": "div",
                      "style": {
                        "base": {
                          "height": "200px",
                          "overflow": "hidden"
                        }
                      },
                      "children": [
                        {
                          "type": "component",
                          "component": "Image",
                          "props": {
                            "image": "{{item.image}}",
                            "alt": "{{item.title}}",
                            "objectFit": "cover",
                            "width": "100%",
                            "height": "200px"
                          }
                        }
                      ]
                    },
                    {
                      "type": "node",
                      "tag": "div",
                      "style": {
                        "base": {
                          "padding": "24px",
                          "flexGrow": "1",
                          "backgroundColor": "var(--bg)"
                        },
                        "tablet": {},
                        "mobile": {}
                      },
                      "children": [
                        {
                          "type": "component",
                          "component": "Badge",
                          "props": {
                            "text": " {{item.label}}"
                          }
                        },
                        {
                          "type": "component",
                          "component": "Spacer",
                          "props": {
                            "size": "16"
                          }
                        },
                        {
                          "type": "component",
                          "component": "Heading",
                          "props": {
                            "text": "{{item.title}}",
                            "size": "5",
                            "tag": "3"
                          }
                        },
                        {
                          "type": "node",
                          "tag": "span",
                          "style": {
                            "base": {
                              "fontSize": "13px",
                              "color": "var(--text-100)"
                            }
                          },
                          "children": "{{item.date}}"
                        },
                        {
                          "type": "component",
                          "component": "Spacer",
                          "props": {
                            "size": "16"
                          }
                        },
                        {
                          "type": "component",
                          "component": "Text",
                          "props": {
                            "text": "{{item.text}}",
                            "size": "small",
                            "variant": "light"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "subtitle": {
        "type": "string",
        "default": "Blog"
      },
      "title": {
        "type": "rich-text",
        "default": "Latest articles"
      },
      "text": {
        "type": "rich-text",
        "default": "Stay up to date with the latest news, tips, and insights."
      },
      "items": {
        "type": "list",
        "itemSchema": {
          "image": {
            "type": "file",
            "default": "/images/placeholder-img.webp"
          },
          "label": {
            "type": "string",
            "default": "Category"
          },
          "title": {
            "type": "string",
            "default": "Article Title"
          },
          "text": {
            "type": "string",
            "default": "Article excerpt goes here."
          },
          "link": {
            "type": "link",
            "default": "#"
          },
          "date": {
            "type": "string",
            "default": "Jan 1, 2025"
          }
        },
        "default": [
          {
            "image": "/images/placeholder-img.webp",
            "label": "Technology",
            "title": "Getting Started with Modern Web Development",
            "text": "Learn the fundamentals of modern web development and best practices for building scalable applications.",
            "link": "#",
            "date": "Jan 15, 2025"
          },
          {
            "image": "/images/placeholder-img.webp",
            "label": "Design",
            "title": "Design Systems: A Complete Guide",
            "text": "How to build and maintain a design system that scales with your organization.",
            "link": "#",
            "date": "Jan 10, 2025"
          },
          {
            "image": "/images/placeholder-img.webp",
            "label": "Business",
            "title": "Scaling Your Startup: Lessons Learned",
            "text": "Key insights and strategies for growing your startup from seed to series A.",
            "link": "#",
            "date": "Jan 5, 2025"
          }
        ]
      },
      "theme": {
        "type": "select",
        "default": "primary",
        "enumName": "theme"
      }
    }
  }
}