{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}",
        "spaceTop": "default"
      },
      "children": [
        {
          "type": "component",
          "component": "SplitContent",
          "children": [
            {
              "type": "component",
              "component": "Stack",
              "props": {
                "vertical": "center",
                "horizontal": "left"
              },
              "children": [
                {
                  "type": "component",
                  "component": "Subtitle",
                  "if": "{{subtitle}}",
                  "props": {
                    "text": "{{subtitle}}",
                    "align": "left",
                    "fade": "0"
                  }
                },
                {
                  "type": "component",
                  "component": "Heading",
                  "props": {
                    "text": "{{title}}",
                    "maxWidth": "100%",
                    "align": "left",
                    "size": "1",
                    "tag": "2",
                    "fade": "0.2"
                  }
                },
                {
                  "type": "component",
                  "component": "Text",
                  "if": "{{text}}",
                  "props": {
                    "text": "{{text}}",
                    "size": "large",
                    "align": "left",
                    "maxWidth": "100%",
                    "fade": "0.4"
                  }
                },
                {
                  "type": "component",
                  "component": "ButtonList",
                  "props": {
                    "fade": "0.6"
                  },
                  "children": [
                    {
                      "type": "component",
                      "component": "Button",
                      "props": {
                        "text": "Get started",
                        "link": "",
                        "variant": "primary"
                      }
                    },
                    {
                      "type": "component",
                      "component": "Button",
                      "props": {
                        "text": "Learn more",
                        "link": "",
                        "variant": "secondary",
                        "isMarginTop": false
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "component",
              "component": "Image",
              "props": {
                "image": "{{image}}",
                "rounded": "large",
                "fade": "0.4"
              }
            }
          ]
        }
      ]
    },
    "interface": {
      "subtitle": {
        "type": "string",
        "default": "Feature"
      },
      "title": {
        "type": "rich-text",
        "default": "Powerful feature that makes a difference"
      },
      "text": {
        "type": "rich-text",
        "default": "This feature helps you accomplish your goals faster and more efficiently than ever before."
      },
      "image": {
        "type": "file",
        "default": "/images/placeholder-img.webp",
        "accept": "image/*"
      },
      "theme": {
        "type": "select",
        "default": "primary",
        "enumName": "theme"
      }
    }
  }
}