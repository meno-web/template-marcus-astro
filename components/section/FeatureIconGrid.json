{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}",
        "spaceTop": "default"
      },
      "children": [
        {
          "type": "component",
          "component": "SectionHeader",
          "props": {
            "isCenter": true,
            "maxWidth": "640px"
          },
          "children": [
            {
              "type": "component",
              "component": "Subtitle",
              "if": "{{subtitle}}",
              "props": {
                "text": "{{subtitle}}",
                "align": "center",
                "fade": "0"
              }
            },
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "{{title}}",
                "align": "center",
                "size": "2",
                "tag": "2",
                "fade": "0.2"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "if": "{{text}}",
              "props": {
                "text": "{{text}}",
                "size": "large",
                "align": "center",
                "maxWidth": "460px",
                "variant": "default",
                "fade": "0.4"
              }
            }
          ]
        },
        {
          "type": "component",
          "component": "Grid",
          "props": {
            "columns": "{{columns}}",
            "fade": "0.4"
          },
          "children": [
            {
              "type": "list",
              "sourceType": "prop",
              "source": "{{items}}",
              "itemAs": "item",
              "children": [
                {
                  "type": "node",
                  "tag": "div",
                  "label": "Card",
                  "style": {
                    "base": {
                      "display": "flex",
                      "flexDirection": "column",
                      "alignItems": "center",
                      "textAlign": "center",
                      "padding": "32px 24px",
                      "background": "var(--bg-100)",
                      "borderRadius": "0px"
                    },
                    "tablet": {},
                    "mobile": {}
                  },
                  "children": [
                    {
                      "type": "node",
                      "tag": "div",
                      "label": "Icon Wrap",
                      "style": {
                        "base": {
                          "width": "64px",
                          "height": "64px",
                          "backgroundColor": "var(--accent)",
                          "borderRadius": "2px",
                          "display": "flex",
                          "alignItems": "center",
                          "justifyContent": "center",
                          "marginBottom": "20px"
                        },
                        "tablet": {},
                        "mobile": {}
                      },
                      "children": [
                        {
                          "type": "component",
                          "component": "Icon",
                          "props": {
                            "size": 24,
                            "icon": "{{item.icon}}"
                          }
                        }
                      ]
                    },
                    {
                      "type": "component",
                      "component": "Heading",
                      "props": {
                        "text": "{{item.title}}",
                        "size": "5",
                        "tag": "3",
                        "align": "center"
                      }
                    },
                    {
                      "type": "component",
                      "component": "Text",
                      "props": {
                        "text": "{{item.text}}",
                        "size": "small",
                        "variant": "light",
                        "align": "center"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "subtitle": {
        "type": "string",
        "default": "Features"
      },
      "title": {
        "type": "rich-text",
        "default": "Everything you need to launch"
      },
      "text": {
        "type": "rich-text",
        "default": "This template comes packed with ready-to-use sections. Customize them to match your brand."
      },
      "columns": {
        "type": "select",
        "default": "3",
        "options": [
          "2",
          "3",
          "4",
          "6"
        ]
      },
      "theme": {
        "type": "select",
        "default": "light",
        "enumName": "theme"
      },
      "items": {
        "type": "list",
        "itemSchema": {
          "icon": {
            "type": "select",
            "default": "zap",
            "enumName": "icons"
          },
          "title": {
            "type": "string",
            "default": "Feature"
          },
          "text": {
            "type": "rich-text"
          }
        },
        "default": [
          {
            "icon": "zap",
            "title": "Responsive Design",
            "text": "Every section adapts beautifully to desktop, tablet, and mobile screens."
          },
          {
            "icon": "settings",
            "title": "Easy to Customize",
            "text": "Change colors, fonts, spacing, and content directly in the visual editor."
          },
          {
            "icon": "shield",
            "title": "Production Ready",
            "text": "Clean markup, fast load times, and SEO-friendly structure out of the box."
          },
          {
            "icon": "headphones",
            "title": "40+ Components",
            "text": "Hero sections, feature grids, testimonials, pricing cards, and more included."
          },
          {
            "icon": "trending-up",
            "title": "Scalable Structure",
            "text": "Add pages, sections, and components as your site grows."
          },
          {
            "icon": "bar-chart-3",
            "title": "CMS Built In",
            "text": "Manage blog posts, team members, and dynamic content with collections."
          }
        ]
      }
    }
  }
}