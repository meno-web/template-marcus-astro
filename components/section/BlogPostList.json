{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}"
      },
      "children": [
        {
          "type": "component",
          "component": "SectionHeader",
          "children": [
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "Blog",
                "size": "1",
                "tag": "1",
                "fade": "0"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "props": {
                "text": "Latest articles and insights from our team.",
                "fade": "0.2"
              }
            }
          ]
        },
        {
          "type": "list",
          "sourceType": "collection",
          "source": "posts",
          "itemAs": "post",
          "sort": {
            "field": "publishedAt",
            "direction": "desc"
          },
          "children": [
            {
              "type": "link",
              "href": "{{item._url}}",
              "style": {
                "base": {
                  "display": "grid",
                  "gridTemplateColumns": "400px 1fr",
                  "gap": "32px",
                  "alignItems": "start",
                  "paddingTop": "32px",
                  "paddingBottom": "32px",
                  "borderBottom": "1px solid var(--border-100)",
                  "textDecoration": "none",
                  "color": "inherit"
                },
                "tablet": {
                  "gridTemplateColumns": "200px 1fr",
                  "gap": "24px"
                },
                "mobile": {
                  "gridTemplateColumns": "1fr",
                  "gap": "16px"
                }
              },
              "children": [
                {
                  "type": "component",
                  "component": "Image",
                  "props": {
                    "image": "{{post.featuredImage}}",
                    "alt": "{{post.title}}",
                    "objectFit": "cover",
                    "height": "100%",
                    "border": true,
                    "rounded": "medium"
                  }
                },
                {
                  "type": "node",
                  "tag": "div",
                  "style": {
                    "base": {
                      "display": "flex",
                      "flexDirection": "column"
                    },
                    "tablet": {},
                    "mobile": {}
                  },
                  "children": [
                    {
                      "type": "component",
                      "component": "Text",
                      "props": {
                        "text": "{{post.publishedAt}}",
                        "size": "small",
                        "variant": "light"
                      }
                    },
                    {
                      "type": "component",
                      "component": "Spacer",
                      "props": {
                        "size": "8"
                      }
                    },
                    {
                      "type": "component",
                      "component": "Heading",
                      "props": {
                        "text": "{{post.title}}",
                        "tag": "2",
                        "size": "4"
                      }
                    },
                    {
                      "type": "component",
                      "component": "Text",
                      "props": {
                        "text": "{{post.excerpt}}",
                        "variant": "light",
                        "size": "default"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "theme": {
        "type": "select",
        "default": "primary",
        "enumName": "theme"
      }
    }
  }
}