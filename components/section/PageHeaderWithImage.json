{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}",
        "spaceTop": "default"
      },
      "children": [
        {
          "type": "component",
          "component": "Stack",
          "props": {
            "vertical": "top",
            "horizontal": "center"
          },
          "children": [
            {
              "type": "node",
              "tag": "div",
              "style": {
                "base": {
                  "width": "100%",
                  "maxWidth": "900px"
                },
                "tablet": {},
                "mobile": {}
              },
              "children": [
                {
                  "type": "component",
                  "component": "Image",
                  "props": {
                    "image": "{{image}}",
                    "height": "400px",
                    "border": false,
                    "rounded": "large",
                    "objectFit": "cover",
                    "fade": "0"
                  }
                }
              ]
            },
            {
              "type": "component",
              "component": "Spacer",
              "props": {
                "size": "64"
              }
            },
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "{{title}}",
                "maxWidth": "480px",
                "align": "center",
                "size": "1",
                "tag": "1",
                "variant": "default",
                "fade": "0.2"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "if": "{{text}}",
              "props": {
                "text": "{{text}}",
                "size": "large",
                "align": "center",
                "maxWidth": "580px",
                "isMarginBottom": true,
                "fade": "0.4"
              }
            }
          ]
        }
      ]
    },
    "interface": {
      "title": {
        "type": "rich-text",
        "default": "Page title"
      },
      "text": {
        "type": "rich-text",
        "default": "A brief description of this page and what visitors can expect to find here."
      },
      "image": {
        "type": "file",
        "default": "/images/placeholder-img.webp",
        "accept": "image/*"
      },
      "theme": {
        "type": "select",
        "default": "primary",
        "enumName": "theme"
      }
    }
  }
}