{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}",
        "spaceTop": "default"
      },
      "children": [
        {
          "type": "component",
          "component": "SplitContent",
          "children": [
            {
              "type": "component",
              "component": "Image",
              "props": {
                "image": "{{image}}",
                "rounded": "large",
                "fade": "0.4"
              }
            },
            {
              "type": "component",
              "component": "Stack",
              "props": {
                "vertical": "center",
                "horizontal": "left"
              },
              "children": [
                {
                  "type": "component",
                  "component": "Subtitle",
                  "if": "{{subtitle}}",
                  "props": {
                    "text": "{{subtitle}}",
                    "align": "left",
                    "fade": "0"
                  }
                },
                {
                  "type": "component",
                  "component": "Heading",
                  "props": {
                    "text": "{{title}}",
                    "maxWidth": "100%",
                    "align": "left",
                    "size": "2",
                    "tag": "2",
                    "fade": "0.2"
                  }
                },
                {
                  "type": "component",
                  "component": "Text",
                  "if": "{{text}}",
                  "props": {
                    "text": "{{text}}",
                    "size": "large",
                    "align": "left",
                    "maxWidth": "100%",
                    "fade": "0.4"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "subtitle": {
        "type": "string",
        "default": "Feature"
      },
      "title": {
        "type": "rich-text",
        "default": "Another great feature for your needs"
      },
      "text": {
        "type": "rich-text",
        "default": "Discover how this feature can transform the way you work and boost your productivity."
      },
      "image": {
        "type": "file",
        "accept": "image/*",
        "default": "/images/placeholder-img.webp"
      },
      "theme": {
        "type": "select",
        "default": "primary",
        "enumName": "theme"
      }
    }
  }
}
