{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}",
        "spaceTop": "default"
      },
      "children": [
        {
          "type": "component",
          "component": "SectionHeader",
          "props": {
            "isCenter": true,
            "maxWidth": "600px"
          },
          "children": [
            {
              "type": "component",
              "component": "Subtitle",
              "if": "{{subtitle}}",
              "props": {
                "text": "{{subtitle}}",
                "fade": "0",
                "align": "center"
              }
            },
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "{{title}}",
                "maxWidth": "",
                "fade": "0.2",
                "align": "center",
                "size": "2",
                "tag": "2"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "if": "{{text}}",
              "props": {
                "text": "{{text}}",
                "size": "large",
                "fade": "0.4",
                "align": "center",
                "maxWidth": ""
              }
            }
          ]
        },
        {
          "type": "node",
          "tag": "div",
          "attributes": {
            "fade": 0.4
          },
          "style": {
            "base": {
              "overflowX": "auto"
            }
          },
          "children": [
            {
              "type": "node",
              "tag": "table",
              "style": {
                "base": {
                  "width": "100%",
                  "borderCollapse": "collapse",
                  "minWidth": "500px"
                }
              },
              "children": [
                {
                  "type": "node",
                  "tag": "thead",
                  "children": [
                    {
                      "type": "node",
                      "tag": "tr",
                      "children": [
                        {
                          "type": "node",
                          "tag": "th",
                          "style": {
                            "base": {
                              "textAlign": "left",
                              "padding": "16px 24px",
                              "fontSize": "14px",
                              "fontWeight": "600",
                              "color": "var(--text-secondary)",
                              "borderBottom": "2px solid var(--border)",
                              "textTransform": "uppercase",
                              "letterSpacing": "0.5px"
                            }
                          },
                          "children": "Feature"
                        },
                        {
                          "type": "node",
                          "tag": "th",
                          "style": {
                            "base": {
                              "textAlign": "center",
                              "padding": "16px 24px",
                              "fontSize": "16px",
                              "fontWeight": "600",
                              "color": "var(--text)",
                              "borderBottom": "2px solid var(--border)"
                            }
                          },
                          "children": "{{column1Title}}"
                        },
                        {
                          "type": "node",
                          "tag": "th",
                          "style": {
                            "base": {
                              "textAlign": "center",
                              "padding": "16px 24px",
                              "fontSize": "16px",
                              "fontWeight": "600",
                              "color": "var(--text)",
                              "borderBottom": "2px solid ",
                              "backgroundColor": "var(--bg-100)"
                            },
                            "tablet": {},
                            "mobile": {}
                          },
                          "children": "{{column2Title}}"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list",
                  "sourceType": "prop",
                  "source": "{{items}}",
                  "itemAs": "item",
                  "children": [
                    {
                      "type": "node",
                      "tag": "tr",
                      "children": [
                        {
                          "type": "node",
                          "tag": "td",
                          "style": {
                            "base": {
                              "padding": "16px 24px",
                              "fontSize": "15px",
                              "color": "var(--text)",
                              "borderBottom": "1px solid var(--border-100)"
                            }
                          },
                          "children": "{{item.title}}"
                        },
                        {
                          "type": "node",
                          "tag": "td",
                          "style": {
                            "base": {
                              "textAlign": "center",
                              "padding": "16px 24px",
                              "borderBottom": "1px solid var(--border-100)"
                            }
                          },
                          "children": "{{item.value}}"
                        },
                        {
                          "type": "node",
                          "tag": "td",
                          "style": {
                            "base": {
                              "textAlign": "center",
                              "padding": "16px 24px",
                              "borderBottom": "1px solid var(--border-100)",
                              "backgroundColor": "var(--surface)"
                            }
                          },
                          "children": "{{item.label}}"
                        }
                      ]
                    }
                  ],
                  "tag": "tbody"
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "subtitle": {
        "type": "string",
        "default": "Compare"
      },
      "title": {
        "type": "rich-text",
        "default": "Choose the right plan"
      },
      "text": {
        "type": "rich-text",
        "default": "See how our plans compare and find the perfect fit for your needs."
      },
      "column1Title": {
        "type": "string",
        "default": "Basic"
      },
      "column2Title": {
        "type": "string",
        "default": "Pro"
      },
      "items": {
        "type": "list",
        "itemSchema": {
          "title": {
            "type": "string",
            "default": "Feature name"
          },
          "value": {
            "type": "string",
            "default": "-"
          },
          "label": {
            "type": "string",
            "default": "Yes"
          }
        },
        "default": [
          {
            "title": "Number of projects",
            "value": "5",
            "label": "Unlimited"
          },
          {
            "title": "Team members",
            "value": "2",
            "label": "Unlimited"
          },
          {
            "title": "Storage",
            "value": "1 GB",
            "label": "100 GB"
          },
          {
            "title": "Priority support",
            "value": "-",
            "label": "Yes"
          },
          {
            "title": "Custom integrations",
            "value": "-",
            "label": "Yes"
          }
        ]
      },
      "theme": {
        "type": "select",
        "default": "primary",
        "enumName": "theme"
      }
    }
  }
}