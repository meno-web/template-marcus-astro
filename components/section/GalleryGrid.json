{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}",
        "spaceTop": "default"
      },
      "children": [
        {
          "type": "component",
          "component": "SectionHeader",
          "props": {
            "isCenter": true,
            "maxWidth": "600px"
          },
          "children": [
            {
              "type": "component",
              "component": "Subtitle",
              "if": "{{subtitle}}",
              "props": {
                "text": "{{subtitle}}",
                "align": "center",
                "fade": "0"
              }
            },
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "{{title}}",
                "maxWidth": "",
                "align": "center",
                "size": "2",
                "tag": "2",
                "fade": "0.2"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "if": "{{text}}",
              "props": {
                "text": "{{text}}",
                "size": "large",
                "align": "center",
                "maxWidth": "",
                "fade": "0.4"
              }
            }
          ]
        },
        {
          "type": "component",
          "component": "Grid",
          "props": {
            "columns": "2",
            "gap": "24",
            "fade": "0.4"
          },
          "children": [
            {
              "type": "list",
              "sourceType": "collection",
              "source": "case-studies",
              "itemAs": "study",
              "sort": {
                "field": "publishedAt",
                "direction": "desc"
              },
              "children": [
                {
                  "type": "link",
                  "href": "/work/{{study.slug}}",
                  "label": "Item",
                  "style": {
                    "base": {
                      "position": "relative",
                      "borderRadius": "12px",
                      "overflow": "hidden",
                      "aspectRatio": "4/3",
                      "display": "block",
                      "textDecoration": "none",
                      "color": "inherit",
                      "transition": "border-radius .2s"
                    },
                    "tablet": {},
                    "mobile": {}
                  },
                  "interactiveStyles": [
                    {
                      "prefix": "",
                      "postfix": ":hover [data-el='overlay']",
                      "style": {
                        "base": {
                          "opacity": "1"
                        }
                      }
                    },
                    {
                      "postfix": ":hover",
                      "style": {
                        "base": {
                          "borderRadius": "40px",
                          "cursor": "pointer"
                        }
                      }
                    },
                    {
                      "postfix": ":hover [data-el='cursor']",
                      "style": {
                        "base": {
                          "opacity": "1"
                        }
                      }
                    }
                  ],
                  "children": [
                    {
                      "type": "node",
                      "tag": "img",
                      "style": {
                        "base": {
                          "width": "100%",
                          "height": "100%",
                          "objectFit": "cover",
                          "transition": "transform 0.3s ease"
                        }
                      },
                      "attributes": {
                        "src": "{{study.image}}",
                        "alt": "{{study.title}}"
                      }
                    },
                    {
                      "type": "node",
                      "tag": "div",
                      "style": {
                        "base": {
                          "position": "absolute",
                          "bottom": "0",
                          "left": "0",
                          "right": "0",
                          "padding": "24px",
                          "background": "linear-gradient(transparent, rgba(0,0,0,0.7))",
                          "opacity": "0",
                          "transition": "opacity 0.3s ease"
                        }
                      },
                      "attributes": {
                        "data-el": "overlay"
                      },
                      "children": [
                        {
                          "type": "node",
                          "tag": "h3",
                          "style": {
                            "base": {
                              "color": "#ffffff",
                              "fontSize": "18px",
                              "margin": "0 0 4px 0",
                              "fontWeight": "600"
                            }
                          },
                          "children": "{{study.title}}"
                        },
                        {
                          "type": "node",
                          "tag": "p",
                          "style": {
                            "base": {
                              "color": "rgba(255,255,255,0.7)",
                              "fontSize": "14px",
                              "margin": "0"
                            }
                          },
                          "children": "{{study.category}}"
                        }
                      ]
                    },
                    {
                      "type": "node",
                      "tag": "div",
                      "style": {
                        "base": {
                          "position": "absolute",
                          "width": "72px",
                          "height": "72px",
                          "borderRadius": "50%",
                          "backgroundColor": "var(--accent)",
                          "display": "flex",
                          "alignItems": "center",
                          "justifyContent": "center",
                          "pointerEvents": "none",
                          "opacity": "0",
                          "transition": "opacity 0.2s",
                          "zIndex": "10",
                          "transform": "translate(-50%, -50%)",
                          "top": "0",
                          "left": "0"
                        },
                        "tablet": {},
                        "mobile": {}
                      },
                      "attributes": {
                        "data-el": "cursor"
                      },
                      "children": [
                        {
                          "type": "embed",
                          "html": "<svg width='20' height='20' viewBox='0 0 16 16' fill='none' xmlns='http://www.w3.org/2000/svg'><path d='M3 8H13M13 8L8.5 3.5M13 8L8.5 12.5' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/></svg>",
                          "style": {
                            "base": {
                              "color": "var(--black)",
                              "height": "19px",
                              "transform": "rotate(-45deg)"
                            },
                            "tablet": {},
                            "mobile": {}
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "subtitle": {
        "type": "string",
        "default": "Portfolio"
      },
      "title": {
        "type": "rich-text",
        "default": "Our recent work"
      },
      "text": {
        "type": "rich-text",
        "default": "Explore some of our latest projects and see what we can create for you."
      },
      "theme": {
        "type": "select",
        "default": "primary",
        "enumName": "theme"
      }
    }
  }
}