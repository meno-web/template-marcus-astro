{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}",
        "spaceTop": "default"
      },
      "children": [
        {
          "type": "component",
          "component": "Heading",
          "props": {
            "text": "{{title}}",
            "maxWidth": "100%",
            "size": "1",
            "tag": "1",
            "variant": "default",
            "align": "left",
            "fade": "0"
          }
        },
        {
          "type": "component",
          "component": "Text",
          "if": "{{text}}",
          "props": {
            "text": "{{text}}",
            "size": "large",
            "maxWidth": "580px",
            "isMarginBottom": true,
            "align": "left",
            "fade": "0.2"
          }
        }
      ]
    },
    "interface": {
      "title": {
        "type": "rich-text",
        "default": "Page title"
      },
      "text": {
        "type": "rich-text",
        "default": "A brief description of this page and what visitors can expect to find here."
      },
      "theme": {
        "type": "select",
        "default": "primary",
        "enumName": "theme"
      }
    }
  }
}