{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}",
        "spaceTop": "default"
      },
      "children": [
        {
          "type": "component",
          "component": "SectionHeader",
          "props": {
            "vertical": "top",
            "horizontal": "center",
            "isCenter": true
          },
          "children": [
            {
              "type": "component",
              "component": "Subtitle",
              "if": "{{subtitle}}",
              "props": {
                "text": "{{subtitle}}",
                "align": "center",
                "fade": "0"
              }
            },
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "{{title}}",
                "maxWidth": "640px",
                "align": "center",
                "size": "2",
                "tag": "2",
                "fade": "0.2"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "if": "{{text}}",
              "props": {
                "text": "{{text}}",
                "size": "large",
                "align": "center",
                "maxWidth": "580px",
                "isMarginBottom": true,
                "fade": "0.4"
              }
            }
          ]
        },
        {
          "type": "component",
          "component": "Grid",
          "props": {
            "columns": "4",
            "gap": "24",
            "fade": "0.4"
          },
          "children": [
            {
              "type": "list",
              "sourceType": "prop",
              "source": "{{items}}",
              "itemAs": "item",
              "children": [
                {
                  "type": "node",
                  "tag": "div",
                  "label": "Stat Card",
                  "style": {
                    "base": {
                      "textAlign": "center",
                      "padding": "24px"
                    }
                  },
                  "children": [
                    {
                      "type": "component",
                      "component": "Heading",
                      "props": {
                        "text": "{{item.value}}",
                        "tag": "3",
                        "align": "center",
                        "size": "1"
                      }
                    },
                    {
                      "type": "component",
                      "component": "Text",
                      "props": {
                        "text": "{{item.label}}",
                        "align": "center",
                        "color": "secondary"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "subtitle": {
        "type": "string",
        "default": "By the numbers"
      },
      "title": {
        "type": "rich-text",
        "default": "Trusted by thousands"
      },
      "text": {
        "type": "rich-text",
        "default": "Our track record speaks for itself. Here are some key metrics."
      },
      "items": {
        "type": "list",
        "itemSchema": {
          "value": {
            "type": "string",
            "default": "100+"
          },
          "label": {
            "type": "string",
            "default": "Label"
          }
        },
        "default": [
          {
            "value": "10K+",
            "label": "Happy customers"
          },
          {
            "value": "99%",
            "label": "Satisfaction rate"
          },
          {
            "value": "50M+",
            "label": "Tasks completed"
          },
          {
            "value": "24/7",
            "label": "Support available"
          }
        ]
      },
      "theme": {
        "type": "select",
        "default": "primary",
        "enumName": "theme"
      }
    }
  }
}
