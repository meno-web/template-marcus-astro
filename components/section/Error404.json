{
  "component": {
    "interface": {
      "theme": {
        "type": "select",
        "default": "primary",
        "enumName": "theme"
      }
    },
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}",
        "spaceTop": "large"
      },
      "children": [
        {
          "type": "component",
          "component": "Stack",
          "props": {
            "vertical": "center",
            "horizontal": "center"
          },
          "children": [
            {
              "type": "node",
              "tag": "span",
              "style": {
                "base": {
                  "fontSize": "120px",
                  "fontWeight": "700",
                  "lineHeight": "1",
                  "color": "var(--primary)",
                  "marginBottom": "24px"
                },
                "mobile": {
                  "fontSize": "80px"
                }
              },
              "attributes": {
                "fade": 0
              },
              "children": "404"
            },
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "Page not found",
                "size": "2",
                "tag": "1",
                "align": "center",
                "fade": "0.2"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "props": {
                "text": "The page you're looking for doesn't exist or has been moved.",
                "align": "center",
                "maxWidth": "320px",
                "isMarginBottom": true,
                "fade": "0.4"
              }
            },
            {
              "type": "component",
              "component": "Button",
              "props": {
                "text": "Back to Home",
                "variant": "primary",
                "isMarginTop": true,
                "link": {
                  "href": "/"
                },
                "fade": "0.6"
              }
            }
          ]
        }
      ]
    }
  }
}