{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}",
        "spaceTop": "default"
      },
      "children": [
        {
          "type": "component",
          "component": "SectionHeader",
          "props": {
            "isCenter": true,
            "maxWidth": "600px"
          },
          "children": [
            {
              "type": "component",
              "component": "Subtitle",
              "if": "{{subtitle}}",
              "props": {
                "text": "{{subtitle}}",
                "align": "center",
                "fade": "0"
              }
            },
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "{{title}}",
                "maxWidth": "",
                "align": "center",
                "size": "2",
                "tag": "2",
                "fade": "0.2"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "if": "{{text}}",
              "props": {
                "text": "{{text}}",
                "size": "large",
                "align": "center",
                "maxWidth": "",
                "fade": "0.4"
              }
            }
          ]
        },
        {
          "type": "component",
          "component": "Grid",
          "props": {
            "columns": "4",
            "gap": "24",
            "fade": "0.4"
          },
          "children": [
            {
              "type": "list",
              "sourceType": "prop",
              "source": "{{items}}",
              "itemAs": "item",
              "children": [
                {
                  "type": "node",
                  "tag": "div",
                  "style": {
                    "base": {
                      "backgroundColor": "var(--surface)",
                      "borderRadius": "12px",
                      "padding": "24px",
                      "border": "1px solid var(--border-100)",
                      "textAlign": "center",
                      "transition": "transform 0.2s ease, box-shadow 0.2s ease"
                    }
                  },
                  "interactiveStyles": [
                    {
                      "prefix": "",
                      "postfix": ":hover",
                      "style": {
                        "base": {
                          "transform": "translateY(-4px)",
                          "boxShadow": "0 8px 24px rgba(0, 0, 0, 0.08)"
                        }
                      }
                    }
                  ],
                  "children": [
                    {
                      "type": "node",
                      "tag": "div",
                      "style": {
                        "base": {
                          "marginBottom": "16px",
                          "display": "inline-block"
                        }
                      },
                      "children": [
                        {
                          "type": "component",
                          "component": "Image",
                          "props": {
                            "image": "{{item.icon}}",
                            "alt": "{{item.title}}",
                            "objectFit": "contain",
                            "width": "48px",
                            "height": "48px"
                          }
                        }
                      ]
                    },
                    {
                      "type": "component",
                      "component": "Heading",
                      "props": {
                        "text": "{{item.title}}",
                        "size": "6",
                        "tag": "3",
                        "align": "center"
                      }
                    },
                    {
                      "type": "component",
                      "component": "Text",
                      "props": {
                        "text": "{{item.text}}",
                        "size": "small",
                        "variant": "light",
                        "align": "center"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "subtitle": {
        "type": "string",
        "default": "Integrations"
      },
      "title": {
        "type": "rich-text",
        "default": "Works with your favorite tools"
      },
      "text": {
        "type": "rich-text",
        "default": "Connect with the apps you already use and love."
      },
      "items": {
        "type": "list",
        "itemSchema": {
          "icon": {
            "type": "file",
            "default": "/images/placeholder-img.webp"
          },
          "title": {
            "type": "string",
            "default": "Integration"
          },
          "text": {
            "type": "string",
            "default": "Description"
          }
        },
        "default": [
          {
            "icon": "/images/placeholder-img.webp",
            "title": "Slack",
            "text": "Team communication"
          },
          {
            "icon": "/images/placeholder-img.webp",
            "title": "Notion",
            "text": "Documentation"
          },
          {
            "icon": "/images/placeholder-img.webp",
            "title": "Figma",
            "text": "Design collaboration"
          },
          {
            "icon": "/images/placeholder-img.webp",
            "title": "GitHub",
            "text": "Code management"
          },
          {
            "icon": "/images/placeholder-img.webp",
            "title": "Jira",
            "text": "Project tracking"
          },
          {
            "icon": "/images/placeholder-img.webp",
            "title": "Zapier",
            "text": "Automation"
          },
          {
            "icon": "/images/placeholder-img.webp",
            "title": "Stripe",
            "text": "Payment processing"
          },
          {
            "icon": "/images/placeholder-img.webp",
            "title": "Google Analytics",
            "text": "Website analytics"
          }
        ]
      },
      "theme": {
        "type": "select",
        "default": "primary",
        "enumName": "theme"
      }
    }
  }
}
