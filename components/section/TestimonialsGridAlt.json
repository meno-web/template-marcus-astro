{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}",
        "spaceTop": "default"
      },
      "children": [
        {
          "type": "component",
          "component": "SectionHeader",
          "props": {
            "isCenter": true,
            "maxWidth": "450px"
          },
          "children": [
            {
              "type": "component",
              "component": "Subtitle",
              "if": "{{subtitle}}",
              "props": {
                "text": "{{subtitle}}",
                "align": "center",
                "fade": "0"
              }
            },
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "{{title}}",
                "maxWidth": "",
                "align": "center",
                "size": "2",
                "tag": "2",
                "fade": "0.2"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "if": "{{text}}",
              "props": {
                "text": "{{text}}",
                "size": "large",
                "align": "center",
                "maxWidth": "",
                "isMarginBottom": true,
                "fade": "0.4"
              }
            }
          ]
        },
        {
          "type": "component",
          "component": "Grid",
          "props": {
            "columns": "2",
            "gap": "24",
            "fade": "0.4"
          },
          "children": [
            {
              "type": "list",
              "sourceType": "prop",
              "source": "{{items}}",
              "itemAs": "item",
              "children": [
                {
                  "type": "component",
                  "component": "Testimonial",
                  "props": {
                    "quote": "{{item.text}}",
                    "avatar": "{{item.image}}",
                    "name": "{{item.title}}",
                    "role": "{{item.label}}",
                    "fade": "{{0.4+itemIndex*0.2}}"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "subtitle": {
        "type": "string",
        "default": "Testimonials"
      },
      "title": {
        "type": "rich-text",
        "default": "What our customers say"
      },
      "text": {
        "type": "rich-text",
        "default": "Don't just take our word for it. Here's what real customers have to say."
      },
      "items": {
        "type": "list",
        "itemSchema": {
          "text": {
            "type": "rich-text",
            "default": "\"This product has completely transformed how we work.\""
          },
          "image": {
            "type": "file",
            "default": "/images/placeholder-img.webp"
          },
          "title": {
            "type": "string",
            "default": "Name"
          },
          "label": {
            "type": "string",
            "default": "Role at Company"
          }
        },
        "default": [
          {
            "text": "\"This product has completely transformed how we work. The interface is intuitive and the results speak for themselves.\"",
            "image": "/images/placeholder-img.webp",
            "title": "Sarah Johnson",
            "label": "CEO at TechCorp"
          },
          {
            "text": "\"We've seen a 40% increase in productivity since implementing this solution.\"",
            "image": "/images/placeholder-img.webp",
            "title": "Michael Chen",
            "label": "Product Manager at StartupXYZ"
          },
          {
            "text": "\"The customer support team is incredible. They helped us get set up in no time.\"",
            "image": "/images/placeholder-img.webp",
            "title": "Emily Rodriguez",
            "label": "Director at Agency Inc"
          },
          {
            "text": "\"Best investment we've made for our team. Highly recommend to anyone looking to scale.\"",
            "image": "/images/placeholder-img.webp",
            "title": "David Kim",
            "label": "CTO at Growth Co"
          },
          {
            "text": "\"The onboarding was seamless and the features are exactly what we needed.\"",
            "image": "/images/placeholder-img.webp",
            "title": "Lisa Wang",
            "label": "Head of Product at Scale Inc"
          },
          {
            "text": "\"Outstanding platform with excellent support. Our team loves using it daily.\"",
            "image": "/images/placeholder-img.webp",
            "title": "James Miller",
            "label": "VP Engineering at DevOps Ltd"
          }
        ]
      },
      "theme": {
        "type": "select",
        "default": "primary",
        "enumName": "theme"
      }
    }
  }
}