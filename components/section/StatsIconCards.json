{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}",
        "spaceTop": "default"
      },
      "children": [
        {
          "type": "component",
          "component": "SectionHeader",
          "props": {
            "isCenter": "{{isCenter}}",
            "maxWidth": ""
          },
          "children": [
            {
              "type": "component",
              "component": "Subtitle",
              "if": "{{subtitle}}",
              "props": {
                "text": "{{subtitle}}",
                "align": {
                  "_mapping": true,
                  "prop": "isCenter",
                  "values": {
                    "default": "left",
                    "true": "center",
                    "false": "left"
                  }
                },
                "fade": "0"
              }
            },
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "{{title}}",
                "maxWidth": "640px",
                "align": {
                  "_mapping": true,
                  "prop": "isCenter",
                  "values": {
                    "default": "left",
                    "true": "center",
                    "false": "left"
                  }
                },
                "size": "2",
                "tag": "2",
                "fade": "0.2"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "if": "{{text}}",
              "props": {
                "text": "{{text}}",
                "size": "large",
                "align": {
                  "_mapping": true,
                  "prop": "isCenter",
                  "values": {
                    "default": "left",
                    "true": "center",
                    "false": "left"
                  }
                },
                "maxWidth": "580px",
                "fade": "0.4"
              }
            }
          ]
        },
        {
          "type": "component",
          "component": "Grid",
          "props": {
            "columns": "{{columns}}",
            "gap": "24",
            "fade": "0.4"
          },
          "children": [
            {
              "type": "list",
              "sourceType": "prop",
              "source": "{{items}}",
              "itemAs": "item",
              "children": [
                {
                  "type": "node",
                  "tag": "div",
                  "label": "Stat Card",
                  "style": {
                    "base": {
                      "display": "flex",
                      "flexDirection": "column",
                      "alignItems": "flex-start",
                      "padding": "32px",
                      "backgroundColor": "var(--bg-100)",
                      "borderRadius": "12px",
                      "borderLeft": {
                        "_mapping": true,
                        "prop": "showAccent",
                        "values": {
                          "default": "4px solid var(--primary)",
                          "true": "4px solid var(--primary)",
                          "false": "none"
                        }
                      }
                    }
                  },
                  "children": [
                    {
                      "type": "node",
                      "tag": "div",
                      "label": "Icon Wrap",
                      "style": {
                        "base": {
                          "width": "48px",
                          "height": "48px",
                          "marginBottom": "16px"
                        }
                      },
                      "children": [
                        {
                          "type": "embed",
                          "html": "{{item.icon}}",
                          "label": "Icon",
                          "style": {
                            "base": {
                              "height": "48px",
                              "color": "var(--primary)"
                            }
                          }
                        }
                      ],
                      "if": "{{item.icon}}"
                    },
                    {
                      "type": "component",
                      "component": "Heading",
                      "props": {
                        "text": "{{item.value}}",
                        "size": "2",
                        "tag": "3"
                      }
                    },
                    {
                      "type": "component",
                      "component": "Text",
                      "props": {
                        "text": "{{item.label}}",
                        "weight": "semibold"
                      }
                    },
                    {
                      "type": "component",
                      "component": "Text",
                      "props": {
                        "text": "{{item.description}}",
                        "size": "small",
                        "color": "secondary"
                      },
                      "if": "{{item.description}}"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "subtitle": {
        "type": "string",
        "default": "Our impact"
      },
      "title": {
        "type": "rich-text",
        "default": "Numbers that speak for themselves"
      },
      "text": {
        "type": "rich-text",
        "default": "We're proud of the results we've achieved together with our clients."
      },
      "isCenter": {
        "type": "boolean",
        "default": false
      },
      "columns": {
        "type": "select",
        "default": "3",
        "options": [
          "2",
          "3",
          "4"
        ]
      },
      "showAccent": {
        "type": "boolean",
        "default": true
      },
      "items": {
        "type": "list",
        "itemSchema": {
          "value": {
            "type": "string",
            "default": "100+"
          },
          "label": {
            "type": "string",
            "default": "Label"
          },
          "description": {
            "type": "string",
            "default": ""
          },
          "icon": {
            "type": "string",
            "default": ""
          }
        },
        "default": [
          {
            "value": "500+",
            "label": "Projects Delivered",
            "description": "Successfully completed projects across various industries",
            "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"/><polyline points=\"22 4 12 14.01 9 11.01\"/></svg>"
          },
          {
            "value": "98%",
            "label": "Client Retention",
            "description": "Clients who continue working with us year after year",
            "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"/><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"/></svg>"
          },
          {
            "value": "15+",
            "label": "Years of Experience",
            "description": "Building expertise and delivering excellence since day one",
            "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><polyline points=\"12 6 12 12 16 14\"/></svg>"
          }
        ]
      },
      "theme": {
        "type": "select",
        "default": "primary",
        "enumName": "theme"
      }
    }
  }
}
