{
  "component": {
    "structure": {
      "type": "node",
      "tag": "div",
      "label": "Panel",
      "style": {
        "base": {
          "padding": "24px 0",
          "width": "100%"
        }
      },
      "interactiveStyles": [
        {
          "postfix": ":nth-of-type(1)",
          "style": {
            "base": {
              "display": "block"
            }
          }
        },
        {
          "postfix": ".is-active",
          "style": {
            "base": {
              "display": "block"
            }
          }
        },
        {
          "postfix": ":not(.is-active)",
          "style": {
            "base": {
              "display": "none"
            }
          }
        }
      ],
      "attributes": {
        "data-tab-panel": "true",
        "class": "{{isOpen ? \"is-active\" : \"\"}}",
        "fade": "{{fade}}"
      },
      "children": [
        {
          "type": "slot"
        }
      ]
    },
    "interface": {
      "isOpen": {
        "type": "boolean",
        "default": false
      },
      "fade": {
        "type": "string",
        "default": ""
      }
    }
  }
}
