{
  "component": {
    "structure": {
      "type": "node",
      "tag": "h{{tag === \"size\" ? size : tag}}",
      "label": "Text",
      "style": {
        "base": {
          "fontSize": {
            "_mapping": true,
            "prop": "size",
            "values": {
              "1": "var(--h-fs)",
              "2": "var(--h2-fs)",
              "3": "var(--h3-fs)",
              "4": "var(--h4-fs)",
              "5": "var(--h5-fs)",
              "6": "var(--h6-fs)",
              "default": "95px"
            }
          },
          "fontWeight": "var(--h-fw)",
          "marginBottom": {
            "_mapping": true,
            "prop": "size",
            "values": {
              "1": "var(--h-s)",
              "2": "var(--h2-s)",
              "3": "var(--h3-s)",
              "4": "var(--h4-s)",
              "5": "var(--h5-s)",
              "6": "var(--h6-s)",
              "default": "20px"
            }
          },
          "letterSpacing": "var(--h-ls)",
          "lineHeight": "var(--h-lh)",
          "maxWidth": "{{maxWidth}}",
          "color": {
            "_mapping": true,
            "prop": "variant",
            "values": {
              "default": "var(--text)",
              "light": "var(--text-100)"
            }
          },
          "textAlign": {
            "_mapping": true,
            "prop": "align",
            "values": {
              "default": "left",
              "light": "",
              "left": "left",
              "center": "center",
              "right": "right"
            }
          },
          "fontFamily": "Instrument Serif"
        },
        "tablet": {},
        "mobile": {}
      },
      "attributes": {
        "fade": "{{fade}}",
        "isMb0": "{{isMb0}}"
      },
      "children": [
        "{{text}}"
      ]
    },
    "interface": {
      "text": {
        "type": "rich-text",
        "default": "Heading"
      },
      "size": {
        "type": "select",
        "default": "1",
        "options": [
          "1",
          "2",
          "3",
          "4",
          "5",
          "6"
        ]
      },
      "variant": {
        "type": "select",
        "default": "default",
        "options": [
          "default",
          "light"
        ]
      },
      "maxWidth": {
        "type": "string",
        "default": "100%"
      },
      "align": {
        "type": "select",
        "default": "left",
        "options": [
          "left",
          "center",
          "right"
        ]
      },
      "tag": {
        "type": "select",
        "default": "size",
        "options": [
          "1",
          "2",
          "3",
          "4",
          "5",
          "6",
          "size"
        ]
      },
      "fade": {
        "type": "string",
        "default": ""
      },
      "isMb0": {
        "type": "boolean",
        "default": false
      }
    },
    "css": "h1 .custom-span,\nh2 .custom-span,\nh3 .custom-span,\nh4 .custom-span,\nh5 .custom-span { color: var(--h-span); }\n\n[is-mb0], [isMb0] {\n  margin-bottom: 0 !important;\n}"
  }
}