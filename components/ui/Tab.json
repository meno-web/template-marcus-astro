{
  "component": {
    "structure": {
      "type": "node",
      "tag": "div",
      "style": {
        "base": {
          "width": "100%"
        }
      },
      "attributes": {
        "data-active-tab": "{{activeTab}}",
        "fade": "{{fade}}"
      },
      "children": [
        {
          "type": "slot",
          "default": [
            {
              "type": "component",
              "component": "TabButtonsList",
              "children": [
                {
                  "type": "component",
                  "component": "TabButton",
                  "props": {
                    "isActive": true,
                    "text": "Tab 1"
                  }
                },
                {
                  "type": "component",
                  "component": "TabButton",
                  "props": {
                    "text": "Tab 2"
                  }
                }
              ]
            },
            {
              "type": "component",
              "component": "TabPanelsList",
              "children": [
                {
                  "type": "component",
                  "component": "TabPanel",
                  "props": {
                    "isOpen": true
                  },
                  "children": [
                    {
                      "type": "component",
                      "component": "Stack",
                      "children": [
                        {
                          "type": "component",
                          "component": "Heading",
                          "props": {
                            "text": "Tab 1",
                            "size": "2"
                          }
                        },
                        {
                          "type": "component",
                          "component": "Text"
                        }
                      ],
                      "props": {
                        "vertical": "top",
                        "horizontal": "center"
                      }
                    }
                  ]
                },
                {
                  "type": "component",
                  "component": "TabPanel",
                  "children": [
                    {
                      "type": "component",
                      "component": "Stack",
                      "children": [
                        {
                          "type": "component",
                          "component": "Heading",
                          "props": {
                            "text": "Tab 2",
                            "size": "2"
                          }
                        },
                        {
                          "type": "component",
                          "component": "Text"
                        }
                      ],
                      "props": {
                        "vertical": "top",
                        "horizontal": "center"
                      }
                    }
                  ],
                  "props": {
                    "isOpen": false
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "activeTab": {
        "type": "number",
        "default": "0"
      },
      "fade": {
        "type": "string",
        "default": ""
      }
    }
  }
}
