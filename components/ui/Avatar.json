{
  "component": {
    "structure": {
      "type": "node",
      "tag": "div",
      "label": "avatar",
      "style": {
        "base": {
          "position": "relative",
          "display": "inline-flex",
          "alignItems": "center",
          "justifyContent": "center",
          "flexShrink": "0",
          "width": {
            "_mapping": true,
            "prop": "size",
            "values": {
              "small": "32px",
              "medium": "40px",
              "large": "56px"
            }
          },
          "height": {
            "_mapping": true,
            "prop": "size",
            "values": {
              "small": "32px",
              "medium": "40px",
              "large": "56px"
            }
          },
          "borderRadius": "100px",
          "overflow": "hidden",
          "backgroundColor": "var(--bg-100)",
          "color": "var(--text-100)",
          "fontSize": {
            "_mapping": true,
            "prop": "size",
            "values": {
              "small": "12px",
              "medium": "14px",
              "large": "18px"
            }
          },
          "fontWeight": "600",
          "lineHeight": "1"
        }
      },
      "children": [
        {
          "type": "node",
          "tag": "img",
          "if": "{{image}}",
          "style": {
            "base": {
              "width": "100%",
              "height": "100%",
              "objectFit": "cover",
              "display": "block"
            }
          },
          "attributes": {
            "src": "{{image}}",
            "alt": "{{alt}}",
            "loading": "lazy"
          },
          "children": []
        },
        {
          "type": "node",
          "tag": "span",
          "if": "{{initials}}",
          "label": "fallback initials",
          "children": "{{initials}}"
        }
      ],
      "attributes": {
        "fade": "{{fade}}"
      }
    },
    "interface": {
      "image": {
        "type": "file",
        "accept": "image/*",
        "default": ""
      },
      "alt": {
        "type": "string",
        "default": ""
      },
      "initials": {
        "type": "string",
        "default": "JD"
      },
      "size": {
        "type": "select",
        "default": "medium",
        "options": [
          "small",
          "medium",
          "large"
        ]
      },
      "fade": {
        "type": "string",
        "default": ""
      }
    }
  }
}
