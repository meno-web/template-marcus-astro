              "3": "repeat(3, 1fr)",
              "4": "repeat(4, 1fr)",
              "5": "repeat(5, 1fr)",
              "6": "repeat(6, 1fr)"
            }
          },
          "gap": {
            "_mapping": true,
            "prop": "gap",
            "values": {
              "2": "24px",
              "3": "",
              "4": "",
              "5": "",
              "6": "",
              "16": "16px",
              "24": "24px",
              "32": "32px",
              "40": "40px"
            }
          }
        },
        "tablet": {
