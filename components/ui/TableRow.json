{
  "component": {
    "interface": {
      "label": {
        "type": "string",
        "default": "Label"
      },
      "value": {
        "type": "string",
        "default": "Value"
      },
      "fade": {
        "type": "string",
        "default": ""
      }
    },
    "structure": {
      "type": "node",
      "tag": "div",
      "style": {
        "base": {
          "display": "grid",
          "gridTemplateColumns": "220px 1fr",
          "borderBottom": "1px solid",
          "borderColor": "var(--border)"
        },
        "mobile": {
          "gridTemplateColumns": "1fr"
        }
      },
      "children": [
        {
          "type": "node",
          "tag": "div",
          "style": {
            "base": {
              "padding": "16px 20px",
              "fontWeight": "600",
              "backgroundColor": "var(--bg-100)",
              "color": "var(--text)"
            }
          },
          "children": [
            "{{label}}"
          ]
        },
        {
          "type": "node",
          "tag": "div",
          "style": {
            "base": {
              "padding": "16px 20px",
              "color": "var(--text)"
            }
          },
          "children": [
            "{{value}}"
          ]
        }
      ],
      "attributes": {
        "fade": "{{fade}}"
      }
    }
  }
}
