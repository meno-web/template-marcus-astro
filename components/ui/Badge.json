{
  "component": {
    "structure": {
      "type": "node",
      "tag": "span",
      "label": "badge",
      "style": {
        "base": {
          "display": "inline-flex",
          "alignItems": "center",
          "fontSize": "13px",
          "fontWeight": "500",
          "lineHeight": "1",
          "padding": "4px 10px",
          "borderRadius": "100px",
          "backgroundColor": {
            "_mapping": true,
            "prop": "variant",
            "values": {
              "default": "var(--bg-100)",
              "primary": "var(--primary)",
              "success": "#16a34a",
              "warning": "#f59e0b"
            }
          },
          "color": {
            "_mapping": true,
            "prop": "variant",
            "values": {
              "default": "var(--text)",
              "primary": "#fff",
              "success": "#fff",
              "warning": "#fff"
            }
          }
        },
        "tablet": {},
        "mobile": {}
      },
      "children": "{{text}}",
      "attributes": {
        "fade": "{{fade}}"
      }
    },
    "interface": {
      "text": {
        "type": "string",
        "default": "Badge"
      },
      "variant": {
        "type": "select",
        "default": "default",
        "options": [
          "default",
          "primary",
          "success",
          "warning"
        ]
      },
      "fade": {
        "type": "string",
        "default": ""
      }
    }
  }
}
