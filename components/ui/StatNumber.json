{
  "component": {
    "structure": {
      "type": "node",
      "tag": "div",
      "style": {
        "base": {
          "fontWeight": "700",
          "lineHeight": "1",
          "fontSize": {
            "_mapping": true,
            "prop": "size",
            "values": {
              "small": "32px",
              "medium": "40px",
              "large": "48px"
            }
          },
          "color": {
            "_mapping": true,
            "prop": "color",
            "values": {
              "primary": "var(--primary)",
              "text": "var(--text)"
            }
          }
        },
        "tablet": {},
        "mobile": {
          "fontSize": {
            "_mapping": true,
            "prop": "size",
            "values": {
              "small": "24px",
              "medium": "32px",
              "large": "40px"
            }
          }
        }
      },
      "children": [
        "{{text}}"
      ],
      "attributes": {
        "fade": "{{fade}}"
      }
    },
    "interface": {
      "text": {
        "type": "string",
        "default": "1"
      },
      "size": {
        "type": "select",
        "default": "large",
        "options": [
          "small",
          "medium",
          "large"
        ]
      },
      "color": {
        "type": "select",
        "default": "primary",
        "options": [
          "primary",
          "text"
        ]
      },
      "fade": {
        "type": "string",
        "default": ""
      }
    }
  }
}
