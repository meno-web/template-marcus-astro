{
  "component": {
    "structure": {
      "type": "node",
      "tag": "div",
      "style": {
        "base": {
          "display": "flex",
          "flexDirection": "row",
          "gap": "16px",
          "justifyContent": {
            "_mapping": true,
            "prop": "justify",
            "values": {
              "center": "center",
              "flex-start": "flex-start",
              "flex-end": "flex-end",
              "space-between": "space-between"
            }
          },
          "marginTop": {
            "_mapping": true,
            "prop": "marginTop",
            "values": {
              "center": "32px",
              "flex-start": "",
              "flex-end": "",
              "space-between": "",
              "default": "28px",
              "large": "64px",
              "none": "0"
            }
          }
        },
        "tablet": {},
        "mobile": {
          "flexDirection": "column",
          "alignItems": "center"
        }
      },
      "attributes": {
        "fade": "{{fade}}"
      },
      "children": [
        {
          "type": "slot",
          "default": [
            {
              "type": "component",
              "component": "Button",
              "props": {
                "text": "Get started",
                "link": "",
                "variant": "primary"
              }
            },
            {
              "type": "component",
              "component": "Button",
              "props": {
                "text": "Learn more",
                "link": "",
                "variant": "secondary",
                "isMarginTop": false
              }
            }
          ]
        }
      ]
    },
    "interface": {
      "justify": {
        "type": "select",
        "default": "center",
        "options": [
          "center",
          "flex-start",
          "flex-end",
          "space-between"
        ]
      },
      "marginTop": {
        "type": "select",
        "default": "default",
        "options": [
          "default",
          "large",
          "none"
        ]
      },
      "fade": {
        "type": "string",
        "default": ""
      }
    }
  }
}