{
  "component": {
    "structure": {
      "type": "node",
      "tag": "section",
      "style": {
        "base": {
          "position": "relative",
          "paddingTop": {
            "_mapping": true,
            "prop": "spaceTop",
            "values": {
              "default": "var(--s-p)",
              "small": "var(--se-p)",
              "none": "0"
            }
          },
          "paddingBottom": {
            "_mapping": true,
            "prop": "spaceBottom",
            "values": {
              "default": "var(--s-p)",
              "small": "var(--se-p)",
              "none": "0"
            }
          },
          "backgroundColor": "var(--bg)",
          "width": "100%",
          "overflow": {
            "_mapping": true,
            "prop": "cropped",
            "values": {
              "true": "hidden",
              "false": "visible"
            }
          }
        },
        "tablet": {},
        "mobile": {}
      },
      "attributes": {
        "theme": "{{theme}}",
        "fade": "{{fade}}"
      },
      "children": [
        {
          "type": "node",
          "tag": "div",
          "if": "{{backgroundImage !== \"\"}}",
          "style": {
            "base": {
              "position": "absolute",
              "top": "0",
              "left": "0",
              "right": "0",
              "bottom": "0",
              "zIndex": "0"
            },
            "tablet": {},
            "mobile": {}
          },
          "children": [
            {
              "type": "component",
              "component": "Image",
              "props": {
                "image": "{{backgroundImage}}",
                "alt": "",
                "width": "100%",
                "height": "100%",
                "objectFit": "cover",
                "border": false,
                "sizes": ""
              }
            },
            {
              "type": "node",
              "tag": "div",
              "style": {
                "base": {
                  "position": "absolute",
                  "top": "0",
                  "left": "0",
                  "right": "0",
                  "bottom": "0",
                  "backgroundColor": "rgba(0, 0, 0, 0.15)"
                },
                "tablet": {},
                "mobile": {}
              }
            }
          ]
        },
        {
          "type": "node",
          "tag": "div",
          "style": {
            "base": {
              "position": "relative",
              "zIndex": "1",
              "padding": "0 80px",
              "maxWidth": {
                "_mapping": true,
                "prop": "maxWidth",
                "values": {
                  "640": "640px",
                  "900": "1060px",
                  "1280": "var(--c-s)"
                }
              },
              "margin": "auto"
            },
            "tablet": {
              "padding": "0 40px"
            },
            "mobile": {
              "padding": "0 20px"
            }
          },
          "children": [
            {
              "type": "slot"
            }
          ]
        }
      ]
    },
    "interface": {
      "theme": {
        "type": "select",
        "default": "light",
        "enumName": "theme"
      },
      "maxWidth": {
        "type": "select",
        "default": "1280",
        "options": [
          "1280",
          "900",
          "640"
        ]
      },
      "spaceTop": {
        "type": "select",
        "default": "default",
        "options": [
          "default",
          "small",
          "none"
        ]
      },
      "spaceBottom": {
        "type": "select",
        "default": "default",
        "options": [
          "default",
          "small",
          "none"
        ]
      },
      "backgroundImage": {
        "type": "file",
        "default": "",
        "accept": "image/*"
      },
      "cropped": {
        "type": "boolean",
        "default": true
      },
      "fade": {
        "type": "string",
        "default": ""
      }
    }
  }
}