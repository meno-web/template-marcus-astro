{
  "component": {
    "structure": {
      "type": "node",
      "tag": "button",
      "style": {
        "base": {
          "padding": "12px 24px",
          "fontSize": "16px",
          "fontWeight": "500",
          "border": "none",
          "borderRadius": "8px",
          "cursor": "pointer",
          "fontFamily": "inherit",
          "backgroundColor": "var(--text)",
          "color": "var(--bg)",
          "transition": "opacity 0.2s",
          "whiteSpace": "nowrap"
        },
        "tablet": {},
        "mobile": {}
      },
      "attributes": {
        "type": "submit"
      },
      "children": [
        "{{text}}"
      ]
    },
    "interface": {
      "text": {
        "type": "string",
        "default": "Submit"
      }
    }
  }
}