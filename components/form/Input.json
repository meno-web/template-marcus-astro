{
  "component": {
    "structure": {
      "type": "node",
      "tag": "input",
      "style": {
        "base": {
          "padding": "12px 16px",
          "fontSize": "16px",
          "border": "1px solid",
          "borderRadius": "8px",
          "outline": "none",
          "width": "100%",
          "boxSizing": "border-box",
          "fontFamily": "inherit",
          "backgroundColor": "var(--bg-100)",
          "borderColor": "var(--text)",
          "color": "var(--text)"
        },
        "tablet": {},
        "mobile": {}
      },
      "attributes": {
        "type": "{{inputType}}",
        "name": "{{name}}",
        "placeholder": "{{placeholder}}"
      }
    },
    "interface": {
      "inputType": {
        "type": "select",
        "default": "text",
        "options": [
          "text",
          "email",
          "password",
          "number",
          "tel",
          "url"
        ]
      },
      "name": {
        "type": "string",
        "default": "field"
      },
      "placeholder": {
        "type": "string",
        "default": "Enter text..."
      }
    }
  }
}