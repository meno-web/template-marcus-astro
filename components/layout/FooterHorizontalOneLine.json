{
  "component": {
    "structure": {
      "type": "node",
      "tag": "footer",
      "label": "Footer",
      "style": {
        "base": {
          "display": "grid",
          "gridTemplateColumns": "1fr auto 1fr",
          "alignItems": "center",
          "padding": "32px 80px",
          "backgroundColor": "var(--bg)",
          "borderTop": "1px solid",
          "borderColor": "var(--border)"
        },
        "tablet": {
          "padding": "24px 40px",
          "display": "flex",
          "flexDirection": "column",
          "gap": "24px"
        },
        "mobile": {
          "padding": "24px 20px"
        }
      },
      "children": [
        {
          "type": "link",
          "href": "/",
          "label": "Logo",
          "style": {
            "base": {}
          },
          "attributes": {
            "aria-label": "Home"
          },
          "children": [
            {
              "type": "node",
              "tag": "span",
              "label": "LogoText",
              "style": {
                "base": {
                  "color": "var(--text)",
                  "fontSize": "18px",
                  "fontWeight": "700",
                  "letterSpacing": "-0.02em"
                },
                "tablet": {},
                "mobile": {}
              },
              "children": "{{brandName}}"
            }
          ]
        },
        {
          "type": "node",
          "tag": "ul",
          "label": "FooterLinks",
          "style": {
            "base": {
              "display": "flex",
              "alignItems": "center",
              "gap": "8px"
            },
            "tablet": {},
            "mobile": {
              "flexDirection": "column",
              "gap": "0"
            }
          },
          "children": [
            {
              "type": "list",
              "sourceType": "prop",
              "source": "{{links}}",
              "itemAs": "link",
              "tag": false,
              "children": [
                {
                  "type": "component",
                  "component": "NavLink",
                  "props": {
                    "text": "{{link.text}}",
                    "link": {
                      "href": "{{link.href}}"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "node",
          "tag": "div",
          "style": {
            "base": {
              "textAlign": "right"
            },
            "tablet": {
              "textAlign": "center"
            },
            "mobile": {}
          },
          "children": [
            {
              "type": "component",
              "component": "Text",
              "props": {
                "size": "small",
                "text": "{{copyright}}",
                "align": "inherit"
              }
            }
          ]
        }
      ]
    },
    "interface": {
      "brandName": {
        "type": "string",
        "default": "Starter"
      },
      "links": {
        "type": "list",
        "itemSchema": {
          "text": {
            "type": "string",
            "default": "Link"
          },
          "href": {
            "type": "link",
            "default": "/"
          }
        },
        "default": [
          {
            "text": "Features",
            "href": "#features"
          },
          {
            "text": "About",
            "href": "#about"
          },
          {
            "text": "Contact",
            "href": "#contact"
          }
        ]
      },
      "copyright": {
        "type": "string",
        "default": "© 2026 Starter. All rights reserved."
      },
      "theme": {
        "type": "select",
        "default": "light",
        "enumName": "theme"
      }
    }
  }
}