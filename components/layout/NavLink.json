{
  "component": {
    "structure": {
      "type": "node",
      "tag": "li",
      "style": {
        "base": {
          "listStyle": "none"
        }
      },
      "children": [
        {
          "type": "link",
          "href": {
            "_mapping": true,
            "prop": "link",
            "values": {}
          },
          "style": {
            "base": {
              "color": "var(--text)",
              "textDecoration": "none",
              "display": "block",
              "padding": "32px 12px",
              "transition": "background 0.2s",
              "cursor": "pointer"
            },
            "tablet": {
              "padding": "24px 20px"
            },
            "mobile": {}
          },
          "children": "{{text}}"
        }
      ]
    },
    "interface": {
      "text": {
        "type": "string",
        "default": "Link"
      },
      "link": {
        "type": "link"
      }
    }
  }
}