{
  "component": {
    "structure": {
      "type": "node",
      "tag": "div",
      "label": "banner",
      "style": {
        "base": {
          "display": "flex",
          "alignItems": "center",
          "justifyContent": "center",
          "gap": "12px",
          "padding": "10px 80px",
          "fontSize": "var(--ts-fs)",
          "textAlign": "center",
          "backgroundColor": {
            "_mapping": true,
            "prop": "variant",
            "values": {
              "default": "var(--bg-100)",
              "primary": "var(--primary)"
            }
          },
          "color": {
            "_mapping": true,
            "prop": "variant",
            "values": {
              "default": "var(--text)",
              "primary": "#fff"
            }
          },
          "position": "relative",
          "zIndex": "101"
        },
        "tablet": {
          "padding": "10px 40px"
        },
        "mobile": {
          "padding": "10px 20px"
        }
      },
      "children": [
        {
          "type": "node",
          "tag": "span",
          "label": "text",
          "children": "{{text}}"
        },
        {
          "type": "node",
          "tag": "button",
          "label": "close button",
          "if": {
            "_mapping": true,
            "prop": "isDismissible",
            "values": {
              "true": true,
              "false": false
            }
          },
          "style": {
            "base": {
              "background": "none",
              "border": "none",
              "cursor": "pointer",
              "color": "inherit",
              "padding": "4px",
              "display": "flex",
              "alignItems": "center"
            }
          },
          "interactiveStyles": [
            {
              "name": "on hover",
              "postfix": ":hover",
              "style": {
                "base": {
                  "opacity": "0.7"
                }
              }
            }
          ],
          "attributes": {
            "data-el": "close-btn"
          },
          "children": [
            {
              "type": "component",
              "component": "Icon",
              "props": {
                "icon": "x",
                "size": 16
              }
            }
          ]
        }
      ]
    },
    "interface": {
      "text": {
        "type": "rich-text",
        "default": "Currently booking for 2026 — Get in touch to discuss your project"
      },
      "variant": {
        "type": "select",
        "default": "default",
        "options": [
          "default",
          "primary"
        ]
      },
      "isDismissible": {
        "type": "boolean",
        "default": true
      }
    }
  }
}