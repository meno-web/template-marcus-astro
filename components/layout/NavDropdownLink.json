{
  "component": {
    "structure": {
      "type": "node",
      "tag": "li",
      "style": {
        "base": {
          "listStyle": "none"
        }
      },
      "children": [
        {
          "type": "link",
          "href": {
            "_mapping": true,
            "prop": "link",
            "values": {}
          },
          "style": {
            "base": {
              "color": "var(--text)",
              "textDecoration": "none",
              "display": "block",
              "padding": "10px 16px",
              "borderRadius": "4px",
              "transition": "background 0.2s",
              "cursor": "pointer"
            },
            "tablet": {
              "padding": "10px 16px"
            },
            "mobile": {}
          },
          "interactiveStyles": [
            {
              "name": "hover",
              "prefix": "",
              "postfix": ":hover",
              "style": {
                "base": {
                  "backgroundColor": "var(--bg-100)"
                }
              }
            }
          ],
          "children": "{{text}}"
        }
      ]
    },
    "interface": {
      "text": {
        "type": "string",
        "default": "Link"
      },
      "link": {
        "type": "link"
      }
    }
  }
}