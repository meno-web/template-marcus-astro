---
import { BaseLayout } from 'meno-astro/components';
import CTACentered from '../components/section/CTACentered.astro';
import ContentCentered from '../components/section/ContentCentered.astro';
import FeatureIconGrid from '../components/section/FeatureIconGrid.astro';
import FeatureSplitImageLeft from '../components/section/FeatureSplitImageLeft.astro';
import Layout from '../components/layout/Layout.astro';
import PageHeaderCentered from '../components/section/PageHeaderCentered.astro';
import '../styles/theme.css';

const meta = {
  title: "Gear — Marcus Cole",
  description: "The cameras, lenses, lighting, and tools Marcus Cole uses for cinematography and filmmaking. Cinema-grade equipment for every production."
};
---
<BaseLayout meta={meta}>
  <Layout>
    <PageHeaderCentered theme="dark" title={`My <span>Gear</span>`} text="The tools behind the image. Every camera, lens, and light is chosen with intention — because the right gear disappears and lets the story lead." />
    <FeatureSplitImageLeft theme="light" subtitle="Philosophy" title={`The right tool for <span>every story</span>`} text="I don't believe in a one-size-fits-all kit. A run-and-gun documentary calls for a different setup than a controlled studio shoot. I choose my gear based on the story, the environment, and the emotion we're chasing — not brand loyalty or spec sheets." image="/images/placeholder-img.webp" />
    <FeatureIconGrid theme="muted" subtitle="Kit" title="What I shoot with" text="A curated selection of cinema-grade tools for every stage of production." columns="3" items={[
        {
          icon: "video",
          title: "Cameras",
          text: "RED V-Raptor, ARRI Alexa Mini, Sony FX6 — each chosen for different production scales and creative demands."
        },
        {
          icon: "eye",
          title: "Lenses",
          text: "Cooke S4/i Primes, Canon CN-E Primes, Sigma Art Series — from soft and organic to sharp and clinical."
        },
        {
          icon: "sun",
          title: "Lighting",
          text: "ARRI SkyPanel S60, Aputure 600d Pro, Astera Titan Tubes — precise control for any mood or environment."
        },
        {
          icon: "headphones",
          title: "Audio",
          text: "Sennheiser MKH 416, Sound Devices MixPre-6 II, DPA 4017 — clean, reliable sound capture on every set."
        },
        {
          icon: "move",
          title: "Stabilization",
          text: "DJI Ronin 4D, Steadicam M-1, Dana Dolly — smooth motion from handheld to dolly and everything in between."
        },
        {
          icon: "monitor",
          title: "Monitors & Wireless",
          text: "SmallHD Cine 13, Teradek Bolt 4K, full DIT station — accurate monitoring and real-time review on set."
        }
      ]} />
    <ContentCentered theme="light" subtitle="Approach" title={`Gear follows the <span>story</span>`} text="Every project starts with a conversation about tone, mood, and visual language — not a gear list. The camera package, lighting plan, and support equipment are all shaped by what the story needs. Whether it's a stripped-down two-person doc crew or a full commercial package with a DIT tent, I scale the kit to serve the project, never the other way around." />
    <CTACentered theme="dark" title={`Let's plan your <span>shoot</span>`} text="Have a project in mind? Let's talk about the right approach and the right tools to bring it to life." buttonText="Get in touch" buttonLink={{ href: "/contact" }} secondaryButtonText="View selected work" secondaryButtonLink={{ href: "/work" }} />
  </Layout>
</BaseLayout>
