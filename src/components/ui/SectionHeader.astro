---
import { cx, inlineStyle, resolveProps, style, variants } from 'meno-astro';

const __props = resolveProps(Astro, {
  isCenter: { type: "boolean", default: false },
  maxWidth: { type: "string", default: "100%" },
  fade: { type: "string", default: "" }
});
const { isCenter, maxWidth, fade, class: className } = __props;
---
<div class={cx(style({ base: { maxWidth: "{{maxWidth}}" } }, __props), variants(__props, {
    isCenter: {
      default: "items-start text-left",
      true: "items-center text-center",
      false: "items-start text-left"
    }
  }), "mr-auto mb-20 ml-auto flex flex-col", className)} style={inlineStyle({ "max-width": `${maxWidth}` }, __props)} fade={fade || undefined}><slot /></div>
