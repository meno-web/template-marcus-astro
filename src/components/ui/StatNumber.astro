---
import { cx, resolveProps, style, variants } from 'meno-astro';

const __props = resolveProps(Astro, {
  text: { type: "string", default: "1" },
  size: {
    type: "select",
    default: "large",
    options: ["small", "medium", "large"]
  },
  color: { type: "select", default: "primary", options: ["primary", "text"] },
  fade: { type: "string", default: "" }
});
const { text, size, color, fade, class: className } = __props;
---
<div class={cx(style({
    base: {},
    mobile: {
      fontSize: {
        _mapping: true,
        prop: "size",
        values: { small: "24px", medium: "32px", large: "40px" }
      }
    }
  }, __props), variants(__props, {
    size: { small: "text-[32px]", medium: "text-[40px]", large: "text-[48px]" },
    color: { primary: "text-(--primary)", text: "text-(--text)" }
  }), "font-[700] leading-[1]", className)} fade={fade || undefined}>{text}</div>
