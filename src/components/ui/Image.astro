---
import { cx, resolveProps, style, variants } from 'meno-astro';
import { MenoImage } from 'meno-astro/components';

const __props = resolveProps(Astro, {
  alt: { type: "string", default: "" },
  loading: { type: "select", default: "lazy", options: ["lazy", "eager"] },
  objectFit: {
    type: "select",
    default: "cover",
    options: ["cover", "contain", "fill", "scale-down"]
  },
  image: { type: "file", accept: "image/*" },
  height: { type: "string" },
  border: { type: "boolean" },
  rounded: {
    type: "select",
    default: "none",
    options: ["large", "medium", "none"]
  },
  fetchpriority: {
    type: "select",
    default: "auto",
    options: ["auto", "high", "low"]
  },
  sizes: { type: "string", default: "" },
  width: { type: "string", default: "100%" },
  aspectRatio: { type: "string", default: "" },
  fade: { type: "string", default: "" }
});
const {
  alt,
  loading,
  objectFit,
  image,
  height,
  border,
  rounded,
  fetchpriority,
  sizes,
  width,
  aspectRatio,
  fade,
  class: className,
} = __props;
---
<MenoImage class={cx(style({
    base: {
      height: "{{height}}",
      objectFit: "{{objectFit}}",
      width: "{{width}}",
      aspectRatio: "{{aspectRatio}}"
    }
  }, __props), variants(__props, {
    border: {
      default: "border-[1px_solid]",
      true: "border-[1px_solid]",
      false: "border-[none]"
    },
    rounded: {
      default: "rounded-none",
      true: "rounded-[12px]",
      false: "rounded-none",
      large: "rounded-[12px]",
      none: "rounded-none",
      medium: "rounded-[8px]"
    }
  })) + " block max-w-full border-border"} style={`--m-base-height: ${height}; --m-base-object-fit: ${objectFit}; --m-base-width: ${width}; --m-base-aspect-ratio: ${aspectRatio}`} src={image || undefined} alt={alt || undefined} loading={loading || undefined} fetchpriority={fetchpriority || undefined} sizes={sizes || undefined} fade={fade || undefined} />
