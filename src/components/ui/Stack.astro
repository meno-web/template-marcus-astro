---
import { cx, resolveProps, variants } from 'meno-astro';

const __props = resolveProps(Astro, {
  vertical: {
    type: "select",
    default: "left",
    options: ["top", "center", "bottom", "spaceBetween"]
  },
  horizontal: {
    type: "select",
    default: "left",
    options: ["left", "center", "right", "spaceBetween"]
  },
  fade: { type: "string", default: "" }
});
const { vertical, horizontal, fade, class: className } = __props;

const __meno = { category: "ui" };
---
<div class={cx(variants(__props, {
    vertical: {
      center: "justify-center",
      spaceBetween: "[justify-content:spaceBetween]",
      top: "justify-start",
      bottom: "justify-end"
    },
    horizontal: {
      left: "items-start",
      center: "items-center",
      right: "items-end",
      spaceBetween: "[align-items:space-between]"
    }
  }), "flex flex-col", className)} fade={fade || undefined}><slot /></div>
