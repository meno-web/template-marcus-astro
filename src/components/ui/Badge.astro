---
import { cx, resolveProps, style, variants } from 'meno-astro';

const __props = resolveProps(Astro, {
  text: { type: "string", default: "Badge" },
  variant: {
    type: "select",
    default: "default",
    options: ["default", "primary", "success", "warning"]
  },
  fade: { type: "string", default: "" }
});
const { text, variant, fade, class: className } = __props;
---
<span class={cx(style({ base: {} }, __props, { label: "badge" }), variants(__props, {
    variant: {
      default: "bg-[var(--bg-100)] text-(--text)",
      primary: "bg-(--primary) text-[#fff]",
      success: "bg-[#16a34a] text-[#fff]",
      warning: "bg-[#f59e0b] text-[#fff]"
    }
  }), "p-[4px_10px] inline-flex items-center rounded-[100px] text-[13px] font-[500] leading-[1]", className)} fade={fade || undefined}>{text}</span>
