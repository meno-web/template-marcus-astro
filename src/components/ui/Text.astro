---
import { cx, inlineStyle, resolveProps, richTextWithComponents, style, variants } from 'meno-astro';
import { cmsComponents } from '../../cmsComponents';

const __props = resolveProps(Astro, {
  variant: {
    type: "select",
    default: "default",
    options: ["default", "light", "lighter"]
  },
  size: {
    type: "select",
    default: "default",
    options: ["default", "large", "small"]
  },
  text: { type: "rich-text", default: "Text" },
  maxWidth: { type: "string", default: "100%" },
  align: {
    type: "select",
    default: "left",
    options: ["left", "center", "right", "inherit"]
  },
  fade: { type: "string", default: "" }
});
const {
  variant,
  size,
  text,
  maxWidth,
  align,
  fade,
  class: className,
} = __props;
---
<p class={cx(style({ base: { maxWidth: "{{maxWidth}}" } }, __props), variants(__props, {
    size: {
      default: "text-(length:--t-fs)",
      large: "text-(length:--tl-fs)",
      small: "text-(length:--ts-fs)"
    },
    variant: {
      default: "text-(--text)",
      light: "text-[var(--text-100)]",
      lighter: "text-[var(--text-200)]"
    },
    align: {
      default: "text-left",
      left: "text-left",
      center: "text-center",
      right: "text-right",
      inherit: "[text-align:inherit]"
    }
  }), "font-(number:--t-fw) leading-[150%]", className)} style={inlineStyle({ "max-width": `${maxWidth}` }, __props)} fade={fade || undefined}><Fragment set:html={richTextWithComponents(text, cmsComponents)} /></p>
