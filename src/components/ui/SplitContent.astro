---
import { cx, resolveProps } from 'meno-astro';

const __props = resolveProps(Astro, { fade: { type: "string", default: "" } });
const { fade, class: className } = __props;

const __meno = { category: "ui" };
---
<div class={cx("grid gap-[60px] static grid-cols-[1fr_1fr] max-lg:grid-cols-[1fr]", className)} fade={fade || undefined}><slot /></div>
