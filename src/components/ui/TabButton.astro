---
import { resolveProps, style } from 'meno-astro';

const __props = resolveProps(Astro, {
  isActive: { type: "boolean" },
  text: { type: "string", default: "Tab" },
  fade: { type: "string", default: "" }
});
const { isActive, text, fade, class: className } = __props;
---
<button class={style({
    base: {
      padding: "12px 20px",
      fontSize: "16px",
      fontWeight: "500",
      backgroundColor: "transparent",
      border: "none",
      borderBottom: "2px solid transparent",
      color: "var(--text)",
      cursor: "pointer",
      transition: "all 0.2s ease",
      whiteSpace: "nowrap"
    },
    tablet: {},
    mobile: {}
  }, __props, {
    root: true,
    interactive: [
      {
        postfix: ":hover",
        style: {
          base: { color: "var(--text)", backgroundColor: "var(--bg-100)" }
        }
      },
      {
        postfix: ".is-active",
        style: {
          base: { color: "var(--primary)", borderColor: "var(--primary)" }
        }
      }
    ],
    label: "Tab"
  })} data-tab-button="true" class={isActive ? "is-active" : "" || undefined} fade={fade || undefined}>{text}</button>
