---
import { cx, resolveProps, style } from 'meno-astro';

const __props = resolveProps(Astro, {
  isActive: { type: "boolean" },
  text: { type: "string", default: "Tab" },
  fade: { type: "string", default: "" }
});
const { isActive, text, fade, class: className } = __props;
---
<button class={cx(style({}, __props, {
    interactive: [
      {
        postfix: ":hover",
        style: {
          base: { color: "var(--text)", backgroundColor: "var(--bg-100)" }
        }
      },
      {
        postfix: ".is-active",
        style: {
          base: { color: "var(--primary)", borderColor: "var(--primary)" }
        }
      }
    ],
    label: "Tab"
  }), className)} data-tab-button="true" class={`p-[12px_20px] bg-transparent text-text border-[none] border-b-[2px_solid_transparent] text-[16px] font-[500] whitespace-nowrap cursor-pointer transition-[all_0.2s_ease] ${isActive ? "is-active" : ""}`} fade={fade || undefined}>{text}</button>
