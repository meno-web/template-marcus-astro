---
import { cx, resolveProps } from 'meno-astro';

const __props = resolveProps(Astro, {
  src: { type: "file", default: "", accept: "video/*" },
  poster: { type: "file", default: "", accept: "image/*" },
  controls: { type: "boolean", default: true },
  autoPlay: { type: "boolean", default: false },
  loop: { type: "boolean", default: false },
  muted: { type: "boolean", default: false },
  playsInline: { type: "boolean", default: true },
  fade: { type: "string", default: "" }
});
const {
  src,
  poster,
  controls,
  autoPlay,
  loop,
  muted,
  playsInline,
  fade,
  class: className,
} = __props;
---
<video class={cx("block w-full h-auto max-w-full", className)} src={src || undefined} poster={poster || undefined} controls={controls || undefined} autoPlay={autoPlay || undefined} loop={loop || undefined} muted={muted || undefined} playsInline={playsInline || undefined} fade={fade || undefined} />
