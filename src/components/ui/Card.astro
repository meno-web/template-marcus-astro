---
import { resolveProps, style } from 'meno-astro';

const __props = resolveProps(Astro, {
  variant: { type: "select", default: "default", options: ["default", "light"] },
  fade: { type: "string", default: "" }
});
const { variant, fade, class: className } = __props;
---
<div class={style({
    base: {
      padding: "24px",
      backgroundColor: {
        _mapping: true,
        prop: "variant",
        values: { default: "var(--bg-100)", light: "var(--bg-200)" }
      },
      borderRadius: "6px"
    },
    tablet: {},
    mobile: {}
  }, __props, { root: true, label: "card" })} fade={fade || undefined}><slot /></div>
