---
import { cx, resolveProps, style, variants } from 'meno-astro';

const __props = resolveProps(Astro, {
  variant: { type: "select", default: "default", options: ["default", "light"] },
  fade: { type: "string", default: "" }
});
const { variant, fade, class: className } = __props;
---
<div class={cx(style({ base: {} }, __props, { label: "card" }), variants(__props, { variant: { default: "bg-[var(--bg-100)]", light: "bg-[var(--bg-200)]" } }), "p-6 rounded-[6px]", className)} fade={fade || undefined}><slot /></div>
