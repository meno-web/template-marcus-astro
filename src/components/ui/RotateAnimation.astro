---
import { resolveProps, style } from 'meno-astro';

const __props = resolveProps(Astro, {});
const { class: className } = __props;
---
<div class={style({
    base: {
      position: "absolute",
      zIndex: "-1",
      top: "40%",
      display: "flex",
      justifyContent: "center",
      alignItems: "center",
      animationName: "spin",
      animationDuration: "100s",
      animationTimingFunction: "linear",
      animationIterationCount: "infinite",
      left: "75%"
    },
    tablet: {},
    mobile: {}
  }, __props, { root: true })} fade={0.4}>
  <div class={style({
      base: {
        width: "200px",
        height: "1400px",
        background: "linear-gradient(90deg, #eaf527 0%, #32a160 49%, #82be42 100%)",
        filter: "blur(30px)",
        borderRadius: "50%"
      },
      tablet: {},
      mobile: {}
    }, __props)} />
  <div class={style({
      base: {
        width: "600px",
        height: "600px",
        background: "#1c1c1c",
        filter: "blur(30px)",
        borderRadius: "50%",
        position: "absolute"
      },
      tablet: {},
      mobile: {}
    }, __props)} />
</div>


<style is:global>
@keyframes spin {
  0% { transform: translate(-50%, -50%) rotate(0deg); }
  100% { transform: translate(-50%, -50%) rotate(360deg); }
}

</style>