---
import { cx, resolveProps } from 'meno-astro';

const __props = resolveProps(Astro, {});
const { class: className } = __props;
---
<div class={cx("flex justify-center items-center absolute top-[40%] left-[75%] z--1 [animation-name:spin] [animation-duration:100s] [animation-timing-function:linear] [animation-iteration-count:infinite]", className)} fade={0.4}>
  <div class="w-[200px] h-[1400px] [background:linear-gradient(90deg,_#eaf527_0%,_#32a160_49%,_#82be42_100%)] rounded-[50%] filter-[blur(30px)]" />
  <div class="w-[600px] h-[600px] [background:#1c1c1c] rounded-[50%] filter-[blur(30px)] absolute" />
</div>


<style is:global>
@keyframes spin {
  0% { transform: translate(-50%, -50%) rotate(0deg); }
  100% { transform: translate(-50%, -50%) rotate(360deg); }
}

</style>