---
import { cx, resolveProps, style, variants } from 'meno-astro';
import { MenoImage } from 'meno-astro/components';

const __props = resolveProps(Astro, {
  image: { type: "file", accept: "image/*", default: "" },
  alt: { type: "string", default: "" },
  initials: { type: "string", default: "JD" },
  size: {
    type: "select",
    default: "medium",
    options: ["small", "medium", "large"]
  },
  fade: { type: "string", default: "" }
});
const { image, alt, initials, size, fade, class: className } = __props;
---
<div class={cx(style({ base: {} }, __props, { label: "avatar" }), variants(__props, {
    size: {
      small: "w-8 h-8 text-[12px]",
      medium: "w-10 h-10 text-[14px]",
      large: "w-14 h-14 text-[18px]"
    }
  }), "inline-flex justify-center items-center bg-[var(--bg-100)] text-[var(--text-100)] rounded-[100px] font-[600] leading-[1] relative shrink-0 overflow-hidden", className)} fade={fade || undefined}>
  {image && (
    <MenoImage src={image || undefined} alt={alt || undefined} loading="lazy" class="block w-full h-full object-cover" />
  )}
  {initials && (
    <span class={style({}, __props, { label: "fallback initials" })}>{initials}</span>
  )}
</div>
