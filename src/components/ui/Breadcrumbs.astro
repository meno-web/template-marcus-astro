---
import { cx, list, resolveProps, style } from 'meno-astro';
import { Link } from 'meno-astro/components';

const __props = resolveProps(Astro, {
  items: {
    type: "list",
    itemSchema: {
      label: { type: "string", default: "Page" },
      href: { type: "link", default: { href: "#" } }
    },
    default: [
      { label: "Home", href: { href: "/" } },
      { label: "Features", href: { href: "#features" } },
      { label: "Detail", href: { href: "#" } }
    ]
  },
  fade: { type: "string", default: "" }
});
const { items, fade, class: className } = __props;
---
<nav class={cx(style({}, __props, { label: "breadcrumbs" }), className)} aria-label="Breadcrumbs" fade={fade || undefined}>
  <ol class="p-[0] m-[0] flex items-center flex-wrap gap-3 [list-style:none]">
    {list(items).map((item, itemIndex, itemArr) => (
      <li class="flex items-center gap-1">
        <Link href={item.href} class={style({}, __props, {
            interactive: [
              {
                name: "on hover",
                postfix: ":hover",
                style: { base: { color: "var(--text)" } }
              }
            ]
          }) + " text-[var(--text-100)] text-(length:--ts-fs) no-underline"}>{item.label}</Link>
        {itemIndex === itemArr.length - 1 && (
          <span class="text-[var(--text-100)] text-(length:--ts-fs)">{" / "}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
