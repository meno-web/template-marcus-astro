---
import { resolveProps, style } from 'meno-astro';

const __props = resolveProps(Astro, {
  text: { type: "string", default: "Tooltip text" },
  position: { type: "select", default: "top", options: ["top", "bottom"] },
  fade: { type: "string", default: "" }
});
const { text, position, fade, class: className } = __props;
---
<div class={style({ base: { position: "relative", display: "inline-flex" } }, __props, {
    root: true,
    interactive: [
      {
        name: "show on hover",
        postfix: ":hover [data-el='tooltip-content']",
        style: {
          base: {
            opacity: "1",
            visibility: "visible",
            transform: {
              _mapping: true,
              prop: "position",
              values: {
                top: "translateX(-50%) translateY(0)",
                bottom: "translateX(-50%) translateY(0)"
              }
            }
          }
        }
      }
    ],
    label: "tooltip wrapper"
  })} data-el="tooltip" fade={fade || undefined}>
  <slot />
  <div class={style({
      base: {
        position: "absolute",
        left: "50%",
        transform: {
          _mapping: true,
          prop: "position",
          values: {
            top: "translateX(-50%) translateY(4px)",
            bottom: "translateX(-50%) translateY(-4px)"
          }
        },
        bottom: {
          _mapping: true,
          prop: "position",
          values: { top: "calc(100% + 6px)", bottom: "auto" }
        },
        top: {
          _mapping: true,
          prop: "position",
          values: { top: "auto", bottom: "calc(100% + 6px)" }
        },
        backgroundColor: "var(--text)",
        color: "var(--bg)",
        fontSize: "12px",
        fontWeight: "500",
        lineHeight: "1",
        padding: "6px 10px",
        borderRadius: "6px",
        whiteSpace: "nowrap",
        pointerEvents: "none",
        opacity: "0",
        visibility: "hidden",
        transition: "opacity 0.15s ease, visibility 0.15s ease, transform 0.15s ease",
        zIndex: "10"
      }
    }, __props, { label: "tooltip content" })} data-el="tooltip-content" role="tooltip">{text}</div>
</div>
