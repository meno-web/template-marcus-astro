---
import { cx, resolveProps, style, variants } from 'meno-astro';

const __props = resolveProps(Astro, {
  text: { type: "string", default: "Tooltip text" },
  position: { type: "select", default: "top", options: ["top", "bottom"] },
  fade: { type: "string", default: "" }
});
const { text, position, fade, class: className } = __props;
---
<div class={cx(style({}, __props, {
    interactive: [
      {
        name: "show on hover",
        postfix: ":hover [data-el='tooltip-content']",
        style: {
          base: {
            opacity: "1",
            visibility: "visible",
            transform: {
              _mapping: true,
              prop: "position",
              values: {
                top: "translateX(-50%) translateY(0)",
                bottom: "translateX(-50%) translateY(0)"
              }
            }
          }
        }
      }
    ],
    label: "tooltip wrapper"
  }), "inline-flex relative", className)} data-el="tooltip" fade={fade || undefined}>
  <slot />
  <div class={cx(style({ base: {} }, __props, { label: "tooltip content" }), variants(__props, {
      position: {
        top: "transform-[translateX(-50%)_translateY(4px)] bottom-[calc(100%_+_6px)] top-auto",
        bottom: "transform-[translateX(-50%)_translateY(-4px)] bottom-auto top-[calc(100%_+_6px)]"
      }
    })) + " p-[6px_10px] bg-text text-bg rounded-[6px] text-[12px] font-[500] leading-[1] whitespace-nowrap opacity-0 absolute left-[50%] z-10 pointer-events-none transition-[opacity_0.15s_ease,_visibility_0.15s_ease,_transform_0.15s_ease] invisible"} data-el="tooltip-content" role="tooltip">{text}</div>
</div>
