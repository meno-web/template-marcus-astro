---
import { cx, inlineStyle, resolveProps, style } from 'meno-astro';

const __props = resolveProps(Astro, {
  maxWidth: { type: "string", default: "800px" },
  fade: { type: "string", default: "" }
});
const { maxWidth, fade, class: className } = __props;
---
<div class={cx(style({ base: { maxWidth: "{{maxWidth}}" } }, __props), "m-[0_auto] bg-bg border-[1px_solid] rounded-[8px] border-border overflow-hidden", className)} style={inlineStyle({ "max-width": `${maxWidth}` }, __props)} fade={fade || undefined}><slot /></div>
