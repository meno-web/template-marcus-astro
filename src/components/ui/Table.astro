---
import { inlineStyle, resolveProps, style } from 'meno-astro';

const __props = resolveProps(Astro, {
  maxWidth: { type: "string", default: "800px" },
  fade: { type: "string", default: "" }
});
const { maxWidth, fade, class: className } = __props;
---
<div class={style({
    base: {
      maxWidth: "{{maxWidth}}",
      margin: "0 auto",
      backgroundColor: "var(--bg)",
      borderRadius: "8px",
      overflow: "hidden",
      border: "1px solid",
      borderColor: "var(--border)"
    }
  }, __props, { root: true })} style={inlineStyle({ "max-width": `${maxWidth}` }, __props)} fade={fade || undefined}><slot /></div>
