---
import { resolveProps, style } from 'meno-astro';

const __props = resolveProps(Astro, {
  isOpen: { type: "boolean", default: false },
  fade: { type: "string", default: "" }
});
const { isOpen, fade, class: className } = __props;
---
<div class={style({ base: { padding: "24px 0", width: "100%" } }, __props, {
    root: true,
    interactive: [
      { postfix: ":nth-of-type(1)", style: { base: { display: "block" } } },
      { postfix: ".is-active", style: { base: { display: "block" } } },
      { postfix: ":not(.is-active)", style: { base: { display: "none" } } }
    ],
    label: "Panel"
  })} data-tab-panel="true" class={isOpen ? "is-active" : "" || undefined} fade={fade || undefined}><slot /></div>
