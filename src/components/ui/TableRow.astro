---
import { cx, resolveProps } from 'meno-astro';

const __props = resolveProps(Astro, {
  label: { type: "string", default: "Label" },
  value: { type: "string", default: "Value" },
  fade: { type: "string", default: "" }
});
const { label, value, fade, class: className } = __props;
---
<div class={cx("grid border-b-[1px_solid] border-border grid-cols-[220px_1fr] max-sm:grid-cols-[1fr]", className)} fade={fade || undefined}>
  <div class="p-[16px_20px] bg-[var(--bg-100)] text-text font-[600]">{label}</div>
  <div class="p-[16px_20px] text-text">{value}</div>
</div>
