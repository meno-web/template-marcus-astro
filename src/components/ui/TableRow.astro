---
import { resolveProps, style } from 'meno-astro';

const __props = resolveProps(Astro, {
  label: { type: "string", default: "Label" },
  value: { type: "string", default: "Value" },
  fade: { type: "string", default: "" }
});
const { label, value, fade, class: className } = __props;
---
<div class={style({
    base: {
      display: "grid",
      gridTemplateColumns: "220px 1fr",
      borderBottom: "1px solid",
      borderColor: "var(--border)"
    },
    mobile: { gridTemplateColumns: "1fr" }
  }, __props, { root: true })} fade={fade || undefined}>
  <div class={style({
      base: {
        padding: "16px 20px",
        fontWeight: "600",
        backgroundColor: "var(--bg-100)",
        color: "var(--text)"
      }
    }, __props)}>{label}</div>
  <div class={style({ base: { padding: "16px 20px", color: "var(--text)" } }, __props)}>{value}</div>
</div>
