---
import { href, resolveProps, style } from 'meno-astro';
import { Embed, Link } from 'meno-astro/components';

const __props = resolveProps(Astro, {
  text: { type: "string", default: "Link" },
  variant: {
    type: "select",
    default: "primary",
    options: ["primary", "secondary"]
  },
  isMarginTop: { type: "boolean", default: false },
  link: { type: "link" },
  fade: { type: "string", default: "" }
});
const { text, variant, isMarginTop, link, fade, class: className } = __props;
---
<Link href={href({ _mapping: true, prop: "link" }, __props)} class={style({
    base: {
      fontSize: "var(--b-fs)",
      cursor: "pointer",
      transition: "all 0.2s",
      display: "flex",
      gap: "var(--b-g)",
      alignItems: "center",
      padding: "var(--b-p)",
      border: "1px solid",
      borderColor: {
        _mapping: true,
        prop: "variant",
        values: { primary: "var(--accent)", secondary: "var(--bg-200)" }
      },
      backgroundColor: {
        _mapping: true,
        prop: "variant",
        values: { primary: "var(--accent)", secondary: "var(--bg-200)" }
      },
      color: {
        _mapping: true,
        prop: "variant",
        values: { primary: "var(--black)", secondary: "var(--text)" }
      },
      textDecoration: "none",
      marginTop: {
        _mapping: true,
        prop: "isMarginTop",
        values: { primary: "30px", secondary: "", true: "30px", false: "0" }
      },
      borderRadius: "var(--b-br)",
      fontWeight: "var(--b-fw)",
      flexDirection: "row"
    },
    tablet: {},
    mobile: {}
  }, __props, {
    root: true,
    interactive: [
      {
        name: "on hover",
        postfix: ":hover",
        style: {
          base: {
            backgroundColor: {
              _mapping: true,
              prop: "variant",
              values: {
                primary: "var(--accent-100)",
                secondary: "var(--bg-300)"
              }
            },
            borderColor: {
              _mapping: true,
              prop: "variant",
              values: {
                primary: "var(--accent-100)",
                secondary: "var(--bg-300)"
              }
            },
            top: "0"
          }
        }
      }
    ],
    label: "button"
  })}>
  <span class={style({}, __props, { label: "text" })}>{text}</span>
  <Embed html={`<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>`} class={style({ base: { height: "18px" }, tablet: {}, mobile: {} }, __props, { label: "arrow" })} />
</Link>
