---
import { cx, resolveProps, variants } from 'meno-astro';

const __props = resolveProps(Astro, {
  size: {
    type: "select",
    options: ["8", "16", "24", "32", "40", "48", "56", "64", "72", "80"],
    default: "64"
  },
  fade: { type: "string", default: "" }
});
const { size, fade, class: className } = __props;
---
<div class={cx(variants(__props, {
    size: {
      "8": "pb-2",
      "16": "pb-4",
      "24": "pb-6",
      "32": "pb-8",
      "40": "pb-10",
      "48": "pb-12",
      "56": "pb-14",
      "64": "pb-16",
      "72": "pb-[72px]",
      "80": "pb-20"
    }
  }), "w-full", className)} fade={fade || undefined} />
