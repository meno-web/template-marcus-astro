---
import { inlineStyle, resolveProps, style } from 'meno-astro';

const __props = resolveProps(Astro, {
  text: { type: "rich-text", default: "Heading" },
  size: {
    type: "select",
    default: "1",
    options: ["1", "2", "3", "4", "5", "6"]
  },
  variant: { type: "select", default: "default", options: ["default", "light"] },
  maxWidth: { type: "string", default: "100%" },
  align: {
    type: "select",
    default: "left",
    options: ["left", "center", "right"]
  },
  tag: {
    type: "select",
    default: "size",
    options: ["1", "2", "3", "4", "5", "6", "size"]
  },
  fade: { type: "string", default: "" },
  isMb0: { type: "boolean", default: false }
});
const {
  text,
  size,
  variant,
  maxWidth,
  align,
  tag,
  fade,
  isMb0,
  class: className,
} = __props;

const Tag_0 = `h${tag === "size" ? size : tag}`;
---
<Tag_0 class={style({
    base: {
      fontSize: {
        _mapping: true,
        prop: "size",
        values: {
          "1": "var(--h-fs)",
          "2": "var(--h2-fs)",
          "3": "var(--h3-fs)",
          "4": "var(--h4-fs)",
          "5": "var(--h5-fs)",
          "6": "var(--h6-fs)",
          default: "95px"
        }
      },
      fontWeight: "var(--h-fw)",
      marginBottom: {
        _mapping: true,
        prop: "size",
        values: {
          "1": "var(--h-s)",
          "2": "var(--h2-s)",
          "3": "var(--h3-s)",
          "4": "var(--h4-s)",
          "5": "var(--h5-s)",
          "6": "var(--h6-s)",
          default: "20px"
        }
      },
      letterSpacing: "var(--h-ls)",
      lineHeight: "var(--h-lh)",
      maxWidth: "{{maxWidth}}",
      color: {
        _mapping: true,
        prop: "variant",
        values: { default: "var(--text)", light: "var(--text-100)" }
      },
      textAlign: {
        _mapping: true,
        prop: "align",
        values: {
          default: "left",
          light: "",
          left: "left",
          center: "center",
          right: "right"
        }
      },
      fontFamily: "Instrument Serif"
    },
    tablet: {},
    mobile: {}
  }, __props, { root: true, label: "Text" })} style={inlineStyle({ "max-width": `${maxWidth}` }, __props)} fade={fade || undefined} isMb0={isMb0 || undefined}><Fragment set:html={text} /></Tag_0>


<style is:global>
h1 .custom-span,
h2 .custom-span,
h3 .custom-span,
h4 .custom-span,
h5 .custom-span { color: var(--h-span); }

[is-mb0], [isMb0] {
  margin-bottom: 0 !important;
}
</style>