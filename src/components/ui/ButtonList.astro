---
import { cx, resolveProps, variants } from 'meno-astro';
import Button from './Button.astro';

const __props = resolveProps(Astro, {
  justify: {
    type: "select",
    default: "center",
    options: ["center", "flex-start", "flex-end", "space-between"]
  },
  marginTop: {
    type: "select",
    default: "default",
    options: ["default", "large", "none"]
  },
  fade: { type: "string", default: "" }
});
const { justify, marginTop, fade, class: className } = __props;
---
<div class={cx(variants(__props, {
    justify: {
      center: "justify-center",
      "flex-start": "justify-start",
      "flex-end": "justify-end",
      "space-between": "justify-between"
    },
    marginTop: {
      center: "mt-8",
      default: "mt-7",
      large: "mt-16",
      none: "mt-[0]",
      "flex-start": "",
      "flex-end": "",
      "space-between": ""
    }
  }), "flex flex-row gap-4 max-sm:flex-col max-sm:items-center", className)} fade={fade || undefined}>
  <slot>
    <Button text="Get started" link="" variant="primary" />
    <Button text="Learn more" link="" variant="secondary" isMarginTop={false} />
  </slot>
</div>
