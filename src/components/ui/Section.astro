---
import { cx, resolveProps, variants } from 'meno-astro';
import Image from './Image.astro';

const __props = resolveProps(Astro, {
  theme: { type: "select", default: "light", enumName: "theme" },
  maxWidth: { type: "select", default: "1280", options: ["1280", "900", "640"] },
  spaceTop: {
    type: "select",
    default: "default",
    options: ["default", "small", "none"]
  },
  spaceBottom: {
    type: "select",
    default: "default",
    options: ["default", "small", "none"]
  },
  backgroundImage: { type: "file", default: "", accept: "image/*" },
  cropped: { type: "boolean", default: true },
  fade: { type: "string", default: "" }
});
const {
  theme,
  maxWidth,
  spaceTop,
  spaceBottom,
  backgroundImage,
  cropped,
  fade,
  class: className,
} = __props;
---
<section class={cx(variants(__props, {
    spaceTop: { default: "pt-(--s-p)", small: "pt-(--se-p)", none: "pt-[0]" },
    spaceBottom: { default: "pb-(--s-p)", small: "pb-(--se-p)", none: "pb-[0]" },
    cropped: { true: "overflow-hidden", false: "overflow-visible" }
  }), "w-full bg-bg relative", className)} theme={theme || undefined} fade={fade || undefined}>
  {backgroundImage !== "" && (
    <div class="absolute top-[0] right-[0] bottom-[0] left-[0] z-0">
      <Image image={backgroundImage} alt="" width="100%" height="100%" objectFit="cover" border={false} sizes="" />
      <div class="bg-[rgba(0,_0,_0,_0.15)] absolute top-[0] right-[0] bottom-[0] left-[0]" />
    </div>
  )}
  <div class={variants(__props, {
      maxWidth: {
        "640": "max-w-[640px]",
        "900": "max-w-[1060px]",
        "1280": "max-w-(--c-s)"
      }
    }) + " p-[0_80px] m-auto relative z-1 max-lg:p-[0_40px] max-sm:p-[0_20px]"}><slot /></div>
</section>
