---
import { cx, resolveProps, variants } from 'meno-astro';

const __props = resolveProps(Astro, {
  text: { type: "string", default: "SUBTITLE" },
  variant: { type: "select", default: "default", options: ["default", "light"] },
  fade: { type: "string", default: "" }
});
const { text, variant, fade, class: className } = __props;
---
<p class={cx(variants(__props, { variant: { default: "text-(--text)", light: "text-[var(--text-100)]" } }), "mb-4 text-[13px] font-[600] no-underline uppercase leading-[115%] tracking-[0em]", className)} fade={fade || undefined}>{text}</p>
