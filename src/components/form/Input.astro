---
import { cx, resolveProps } from 'meno-astro';

const __props = resolveProps(Astro, {
  inputType: {
    type: "select",
    default: "text",
    options: ["text", "email", "password", "number", "tel", "url"]
  },
  name: { type: "string", default: "field" },
  placeholder: { type: "string", default: "Enter text..." }
});
const { inputType, name, placeholder, class: className } = __props;
---
<input class={cx("p-[12px_16px] w-full bg-[var(--bg-100)] text-text border-[1px_solid] rounded-[8px] border-text text-[16px] font-[inherit] outline-none box-border", className)} type={inputType || undefined} name={name || undefined} placeholder={placeholder || undefined} />
