---
import { cx, resolveProps } from 'meno-astro';

const __props = resolveProps(Astro, {
  text: { type: "string", default: "Label" },
  htmlFor: { type: "string", default: "" }
});
const { text, htmlFor, class: className } = __props;
---
<label class={cx("block text-text text-[14px] font-[500]", className)} for={htmlFor || undefined}>{text}</label>
