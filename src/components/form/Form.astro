---
import { cx, resolveProps } from 'meno-astro';

const __props = resolveProps(Astro, {
  action: { type: "string", default: "" },
  method: { type: "select", default: "post", options: ["get", "post"] },
  submitHandler: {
    type: "select",
    default: "native",
    options: ["native", "fetch"]
  },
  successMessage: { type: "string", default: "Form submitted successfully!" },
  errorMessage: {
    type: "string",
    default: "Something went wrong. Please try again."
  }
});
const {
  action,
  method,
  submitHandler,
  successMessage,
  errorMessage,
  class: className,
} = __props;

const __meno = { category: "forms" };
---
<form class={cx("flex flex-col gap-4", className)} action={action || undefined} method={method || undefined} data-submit-handler={submitHandler || undefined} data-success-message={successMessage || undefined} data-error-message={errorMessage || undefined}>
  <slot />
  <div data-form-message="true" class="p-[12px_16px] mt-2 hidden rounded-[6px] text-[14px]" />
</form>
