---
import { cx, resolveProps } from 'meno-astro';

const __props = resolveProps(Astro, {
  name: { type: "string", default: "message" },
  placeholder: { type: "string", default: "Enter your message..." },
  rows: { type: "number", default: "4" }
});
const { name, placeholder, rows, class: className } = __props;
---
<textarea class={cx("p-[12px_16px] w-full min-h-[100px] bg-[var(--bg-100)] text-text border-[1px_solid] rounded-[8px] border-text text-[16px] font-[inherit] outline-none box-border resize-y", className)} name={name || undefined} placeholder={placeholder || undefined} rows={rows || undefined} />
