---
import { resolveProps, style } from 'meno-astro';

const __props = resolveProps(Astro, {
  name: { type: "string", default: "message" },
  placeholder: { type: "string", default: "Enter your message..." },
  rows: { type: "number", default: "4" }
});
const { name, placeholder, rows, class: className } = __props;
---
<textarea class={style({
    base: {
      padding: "12px 16px",
      fontSize: "16px",
      border: "1px solid",
      borderRadius: "8px",
      outline: "none",
      width: "100%",
      boxSizing: "border-box",
      fontFamily: "inherit",
      backgroundColor: "var(--bg-100)",
      borderColor: "var(--text)",
      color: "var(--text)",
      resize: "vertical",
      minHeight: "100px"
    },
    tablet: {},
    mobile: {}
  }, __props, { root: true })} name={name || undefined} placeholder={placeholder || undefined} rows={rows || undefined} />
