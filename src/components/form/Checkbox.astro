---
import { cx, resolveProps } from 'meno-astro';

const __props = resolveProps(Astro, {
  name: { type: "string", default: "checkbox" },
  label: { type: "string", default: "Checkbox label" }
});
const { name, label, class: className } = __props;

const __meno = { category: "forms" };
---
<label class={cx("flex items-center gap-2 text-text text-[16px] cursor-pointer", className)}>
  <input type="checkbox" name={name || undefined} class="w-[18px] h-[18px] cursor-pointer accent-primary" />
  <span>{label}</span>
</label>
