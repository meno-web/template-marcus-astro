---
import { cx, resolveProps } from 'meno-astro';

const __props = resolveProps(Astro, {
  name: { type: "string", default: "select" }
});
const { name, class: className } = __props;

const __meno = { category: "forms" };
---
<select class={cx("p-[12px_16px] w-full bg-background text-text border-[1px_solid] rounded-[8px] border-border text-[16px] font-[inherit] outline-none cursor-pointer box-border", className)} name={name || undefined}><slot /></select>
