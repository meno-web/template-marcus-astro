---
import { cx, resolveProps } from 'meno-astro';

const __props = resolveProps(Astro, {
  text: { type: "string", default: "Submit" }
});
const { text, class: className } = __props;
---
<button class={cx("p-[12px_24px] bg-text text-bg border-[none] rounded-[8px] text-[16px] font-[500] font-[inherit] whitespace-nowrap cursor-pointer transition-[opacity_0.2s]", className)} type="submit">{text}</button>
