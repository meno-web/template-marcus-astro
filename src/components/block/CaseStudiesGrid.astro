---
import { cx, resolveProps, style, variants } from 'meno-astro';

const __props = resolveProps(Astro, {
  columns: {
    type: "select",
    default: "2",
    options: ["1", "2", "3", "4", "5", "6"]
  },
  gap: { type: "select", default: "16", options: ["16", "24", "32", "40"] },
  fade: { type: "string", default: "" }
});
const { columns, gap, fade, class: className } = __props;
---
<div class={cx(style({ base: {} }, __props, { label: "grid" }), variants(__props, {
    columns: {
      "1": "grid-cols-[1fr]",
      "2": "grid-cols-[repeat(2,_1fr)]",
      "3": "grid-cols-[repeat(3,_1fr)]",
      "4": "grid-cols-[repeat(4,_1fr)]",
      "5": "grid-cols-[repeat(5,_1fr)]",
      "6": "grid-cols-[repeat(6,_1fr)]"
    },
    gap: {
      "2": "gap-6",
      "3": "",
      "4": "",
      "5": "",
      "6": "",
      "16": "gap-4",
      "24": "gap-6",
      "32": "gap-8",
      "40": "gap-10"
    }
  }), "grid max-lg:grid-cols-[repeat(2,_1fr)] max-sm:grid-cols-[1fr]", className)} fade={fade || undefined}><slot /></div>
