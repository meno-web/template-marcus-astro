---
import { list, resolveProps, style } from 'meno-astro';
import { Embed, Link, MenoImage } from 'meno-astro/components';
import Grid from '../ui/Grid.astro';

const __props = resolveProps(Astro, {
  items: {
    type: "list",
    itemSchema: {
      image: {
        type: "file",
        accept: "image/*",
        default: "/images/placeholder-img.webp"
      },
      title: { type: "string", default: "Project" },
      category: { type: "string", default: "Category" },
      link: { type: "link", default: "#" }
    },
    default: [
      {
        image: "/images/pasted-image-1773393938666.webp",
        title: "Brand Campaign",
        category: "Commercial",
        link: "/work/brand-campaign"
      },
      {
        image: "/images/pasted-image-1773415883515.webp",
        title: "Short Film",
        category: "Narrative",
        link: "/work/short-film"
      },
      {
        image: "/images/pasted-image-1773394149639.webp",
        title: "Music Video",
        category: "Music Video",
        link: "/work/music-video"
      },
      {
        image: "/images/pasted-image-1773415908791.webp",
        title: "Documentary",
        category: "Documentary",
        link: "/work/documentary"
      }
    ]
  }
});
const { items, class: className } = __props;
---
<Grid columns="2" gap="24" fade="0.4" class={style({}, __props, { root: true })}>
  {list(items).map((study, studyIndex) => (
    <Link href={study.link} class={style({}, __props, {
        interactive: [
          {
            prefix: "",
            postfix: ":hover [data-el='overlay']",
            style: { base: { opacity: "1" } }
          },
          {
            postfix: ":hover",
            style: { base: { borderRadius: "40px", cursor: "pointer" } }
          },
          {
            postfix: ":hover [data-el='cursor']",
            style: { base: { opacity: "1" } }
          }
        ]
      }) + " block aspect-[4/3] text-inherit rounded-[12px] no-underline relative overflow-hidden transition-[border-radius_.2s]"}>
      <MenoImage src={study.image || undefined} alt={study.title || undefined} class="w-full h-full transition-[transform_0.3s_ease] object-cover" />
      <div data-el="overlay" class="p-6 [background:linear-gradient(transparent,_rgba(0,0,0,0.7))] opacity-0 absolute right-[0] bottom-[0] left-[0] transition-[opacity_0.3s_ease]">
        <h3 class="m-[0_0_4px_0] text-[#ffffff] text-[18px] font-[600]">{study.title}</h3>
        <p class="m-[0] text-[rgba(255,255,255,0.7)] text-[14px]">{study.category}</p>
      </div>
      <div data-el="cursor" class="flex justify-center items-center w-[72px] h-[72px] bg-accent rounded-[50%] opacity-0 transform-[translate(-50%,_-50%)] absolute top-[0] left-[0] z-10 pointer-events-none transition-[opacity_0.2s]"><Embed html={`<svg width='20' height='20' viewBox='0 0 16 16' fill='none' xmlns='http://www.w3.org/2000/svg'><path d='M3 8H13M13 8L8.5 3.5M13 8L8.5 12.5' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/></svg>`} class="h-[19px] text-[var(--black)] transform-[rotate(-45deg)]" /></div>
    </Link>
  ))}
</Grid>


<script define:vars={{ items }}>
(function(el, props){
var cursors = el.querySelectorAll('[data-el="cursor"]');

cursors.forEach(function(cursor) {
  var card = cursor.parentElement;
  var mouseX = 0, mouseY = 0;
  var cursorX = 0, cursorY = 0;
  var isHovering = false;

  card.addEventListener('mousemove', function(e) {
    var rect = card.getBoundingClientRect();
    mouseX = e.clientX - rect.left;
    mouseY = e.clientY - rect.top;
  });

  card.addEventListener('mouseenter', function(e) {
    var rect = card.getBoundingClientRect();
    mouseX = e.clientX - rect.left;
    mouseY = e.clientY - rect.top;
    cursorX = mouseX;
    cursorY = mouseY;
    isHovering = true;
  });

  card.addEventListener('mouseleave', function() {
    isHovering = false;
  });

  function animate() {
    if (isHovering) {
      cursorX += (mouseX - cursorX) * 0.15;
      cursorY += (mouseY - cursorY) * 0.15;
      cursor.style.left = cursorX + 'px';
      cursor.style.top = cursorY + 'px';
    }
    requestAnimationFrame(animate);
  }
  animate();
});

})((function(){var s=document.currentScript,e=s&&s.previousElementSibling;while(e&&(e.nodeName==='STYLE'||e.nodeName==='SCRIPT'))e=e.previousElementSibling;return e||null;})(), { items });
</script>
