---
import { resolveProps, style } from 'meno-astro';
import Heading from '../ui/Heading.astro';
import Icon from '../ui/Icon.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  question: { type: "string", default: "Question?" },
  answer: { type: "rich-text", default: "Answer goes here." },
  isOpen: { type: "boolean" },
  fade: { type: "string", default: "" }
});
const { question, answer, isOpen, fade, class: className } = __props;
---
<div class={style({
    base: { borderBottom: "1px solid", borderColor: "var(--border)" },
    tablet: {},
    mobile: {}
  }, __props, { root: true, label: "Item" })} class={isOpen ? "is-open" : "" || undefined} fade={fade || undefined}>
  <dt class={style({
      base: {
        padding: "20px 0 8px",
        fontWeight: "600",
        cursor: "pointer",
        opacity: "0.6",
        transition: "opacity .2s",
        display: "flex",
        alignItems: "center",
        justifyContent: "space-between",
        gap: "16px"
      },
      tablet: {},
      mobile: {}
    }, __props, {
      interactive: [
        { name: "on hover", postfix: ":hover", style: { base: { opacity: "1" } } },
        {
          name: "is open",
          prefix: ".is-open ",
          style: { base: { opacity: "1" } }
        }
      ],
      label: "question"
    })} data-el="question">
    {""}
    <div class={style({ base: { flex: "1", minWidth: "0", marginBottom: "calc(-1 * var(--h3-s))" } }, __props)}><Heading text={question} tag="4" variant="default" size="3" /></div>
    <span class={style({
        base: {
          display: "flex",
          alignItems: "center",
          justifyContent: "center",
          flexShrink: "0",
          alignSelf: "center",
          transition: "transform 0.3s ease",
          marginBottom: "8px"
        },
        tablet: {},
        mobile: {}
      }, __props, {
        interactive: [
          {
            name: "is open",
            prefix: ".is-open ",
            style: { base: { transform: "rotate(180deg)" } }
          }
        ],
        label: "icon"
      })}><Icon icon="chevron-down" size={20} /></span>
  </dt>
  <dd class={style({
      base: {
        margin: "0",
        maxWidth: "800px",
        display: "grid",
        gridTemplateRows: "0fr",
        transition: "grid-template-rows 0.3s ease"
      },
      tablet: {},
      mobile: {}
    }, __props, {
      interactive: [
        {
          name: "is open",
          prefix: ".is-open ",
          style: { base: { gridTemplateRows: "1fr" } }
        }
      ],
      label: "answer"
    })} data-el="answer">
    <div class={style({ base: { overflow: "hidden", minHeight: "0" } }, __props)}>
      <div class={style({ base: { paddingBottom: "30px" } }, __props)}>
        {""}
        <Text size="default" text={`${answer} `} variant="default" />
      </div>
    </div>
  </dd>
</div>


<script define:vars={{ question, answer, isOpen, fade }}>
(function(el, props){
const questionEl = el.querySelector('[data-el="question"]');

questionEl?.addEventListener('click', () => {
  const isOpening = !el.classList.contains('is-open');

  el.classList.toggle('is-open');

  if (isOpening) {
    el.dispatchEvent(new CustomEvent('faq-item-open', { bubbles: true }));
  }
});

})((function(){var s=document.currentScript,e=s&&s.previousElementSibling;while(e&&(e.nodeName==='STYLE'||e.nodeName==='SCRIPT'))e=e.previousElementSibling;return e||null;})(), { question, answer, isOpen, fade });
</script>