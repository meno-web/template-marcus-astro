---
import { cx, resolveProps, style } from 'meno-astro';
import Heading from '../ui/Heading.astro';
import Icon from '../ui/Icon.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  question: { type: "string", default: "Question?" },
  answer: { type: "rich-text", default: "Answer goes here." },
  isOpen: { type: "boolean" },
  fade: { type: "string", default: "" }
});
const { question, answer, isOpen, fade, class: className } = __props;
---
<div class={cx(style({}, __props, { label: "Item" }), className)} class={`border-b-[1px_solid] border-border ${isOpen ? "is-open" : ""}`} fade={fade || undefined}>
  <dt class={style({}, __props, {
      interactive: [
        { name: "on hover", postfix: ":hover", style: { base: { opacity: "1" } } },
        {
          name: "is open",
          prefix: ".is-open ",
          style: { base: { opacity: "1" } }
        }
      ],
      label: "question"
    }) + " p-[20px_0_8px] flex justify-between items-center gap-4 font-[600] opacity-60 cursor-pointer transition-[opacity_.2s]"} data-el="question">
    <div class="mb-[calc(-1_*_var(--h3-s))] flex-1 min-w-[0]"><Heading text={question} tag="4" variant="default" size="3" /></div>
    <span class={style({}, __props, {
        interactive: [
          {
            name: "is open",
            prefix: ".is-open ",
            style: { base: { transform: "rotate(180deg)" } }
          }
        ],
        label: "icon"
      }) + " mb-2 flex justify-center items-center shrink-0 self-center transition-[transform_0.3s_ease]"}><Icon icon="chevron-down" size={20} /></span>
  </dt>
  <dd class={style({}, __props, {
      interactive: [
        {
          name: "is open",
          prefix: ".is-open ",
          style: { base: { gridTemplateRows: "1fr" } }
        }
      ],
      label: "answer"
    }) + " m-[0] grid max-w-[800px] grid-rows-[0fr] transition-[grid-template-rows_0.3s_ease]"} data-el="answer"><div class="min-h-[0] overflow-hidden"><div class="pb-[30px]"><Text size="default" text={`${answer} `} variant="default" /></div></div></dd>
</div>


<script define:vars={{ question, answer, isOpen, fade }}>
(function(el, props){
const questionEl = el.querySelector('[data-el="question"]');

questionEl?.addEventListener('click', () => {
  const isOpening = !el.classList.contains('is-open');

  el.classList.toggle('is-open');

  if (isOpening) {
    el.dispatchEvent(new CustomEvent('faq-item-open', { bubbles: true }));
  }
});

})((function(){var s=document.currentScript,e=s&&s.previousElementSibling;while(e&&(e.nodeName==='STYLE'||e.nodeName==='SCRIPT'))e=e.previousElementSibling;return e||null;})(), { question, answer, isOpen, fade });
</script>