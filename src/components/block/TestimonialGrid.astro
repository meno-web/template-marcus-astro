---
import { cx, resolveProps, variants } from 'meno-astro';

const __props = resolveProps(Astro, {
  columns: { type: "select", default: "3", options: ["2", "3", "4"] }
});
const { columns, class: className } = __props;
---
<div class={cx(variants(__props, {
    columns: {
      "2": "grid-cols-[repeat(2,_1fr)]",
      "3": "grid-cols-[repeat(3,_1fr)]",
      "4": "grid-cols-[repeat(4,_1fr)]"
    }
  }), "grid items-stretch gap-6 max-lg:gap-5 max-lg:grid-cols-[repeat(2,_1fr)] max-sm:gap-4 max-sm:grid-cols-[1fr]", className)}><slot /></div>
