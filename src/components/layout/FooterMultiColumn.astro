---
import { list, resolveProps, style } from 'meno-astro';
import FooterLink from './FooterLink.astro';
import Section from '../ui/Section.astro';
import Subtitle from '../ui/Subtitle.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  brandName: { type: "string", default: "Marcus Cole" },
  tagline: { type: "string", default: "Filmmaker & Cinematographer" },
  column1Title: { type: "string", default: "Work" },
  column1Links: {
    type: "list",
    itemSchema: {
      text: { type: "string", default: "Link" },
      href: { type: "link", default: "/" }
    },
    default: [
      { text: "Filmography", href: "/" },
      { text: "Commercials", href: "/" },
      { text: "Music Videos", href: "/" }
    ]
  },
  column2Title: { type: "string", default: "Info" },
  column2Links: {
    type: "list",
    itemSchema: {
      text: { type: "string", default: "Link" },
      href: { type: "link", default: "/" }
    },
    default: [
      { text: "About", href: "/" },
      { text: "Process", href: "/" },
      { text: "Equipment", href: "/" }
    ]
  },
  column3Title: { type: "string", default: "Connect" },
  column3Links: {
    type: "list",
    itemSchema: {
      text: { type: "string", default: "Link" },
      href: { type: "link", default: "/" }
    },
    default: [
      { text: "Contact", href: "/" },
      { text: "Instagram", href: "/" },
      { text: "Vimeo", href: "/" }
    ]
  },
  copyright: {
    type: "string",
    default: "© 2026 Marcus Cole. All rights reserved."
  },
  theme: { type: "select", default: "light", enumName: "theme" }
});
const {
  brandName,
  tagline,
  column1Title,
  column1Links,
  column2Title,
  column2Links,
  column3Title,
  column3Links,
  copyright,
  theme,
  class: className,
} = __props;
---
<Section theme={theme} spaceTop="default" class={style({}, __props, { root: true })}>
  <div class="grid gap-10 grid-cols-[2fr_1fr_1fr_1fr] max-lg:grid-cols-[1fr_1fr] max-sm:grid-cols-[1fr]">
    <div>
      <div class="mb-4 text-text text-[22px] font-[700] tracking-[-0.01em]">{brandName}</div>
      <Text text={tagline} maxWidth="320px" />
    </div>
    <div>
      <Subtitle text={column1Title} variant="default" />
      <nav class="flex flex-col gap-3">
        {list(column1Links).map((link, linkIndex) => (
          <FooterLink link={{ href: link.href }} text={link.text} />
        ))}
      </nav>
    </div>
    <div>
      <Subtitle text={column2Title} variant="default" />
      <nav class="flex flex-col gap-3">
        {list(column2Links).map((link, linkIndex) => (
          <FooterLink link={{ href: link.href }} text={link.text} />
        ))}
      </nav>
    </div>
    <div>
      <Subtitle text={column3Title} variant="default" />
      <nav class="flex flex-col gap-3">
        {list(column3Links).map((link, linkIndex) => (
          <FooterLink link={{ href: link.href }} text={link.text} />
        ))}
      </nav>
    </div>
  </div>
  <div class="pt-6 mt-12 flex justify-between items-center border-t-[1px_solid_var(--border)] max-sm:flex-col max-sm:gap-4 max-sm:text-center">
    <Text text={copyright} size="small" />
    <div class="flex gap-6">
      <FooterLink link={{ href: "" }} text="Privacy policy" />
      <FooterLink text="Terms of Service" link={{ href: "" }} />
    </div>
  </div>
</Section>
