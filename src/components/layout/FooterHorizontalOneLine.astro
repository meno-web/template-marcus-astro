---
import { cx, list, resolveProps, style } from 'meno-astro';
import { Link } from 'meno-astro/components';
import NavLink from './NavLink.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  brandName: { type: "string", default: "Starter" },
  links: {
    type: "list",
    itemSchema: {
      text: { type: "string", default: "Link" },
      href: { type: "link", default: "/" }
    },
    default: [
      { text: "Features", href: "#features" },
      { text: "About", href: "#about" },
      { text: "Contact", href: "#contact" }
    ]
  },
  copyright: { type: "string", default: "© 2026 Starter. All rights reserved." },
  theme: { type: "select", default: "light", enumName: "theme" }
});
const { brandName, links, copyright, theme, class: className } = __props;
---
<footer class={cx(style({}, __props, { label: "Footer" }), "p-[32px_80px] grid items-center bg-bg border-t-[1px_solid] border-border grid-cols-[1fr_auto_1fr] max-lg:p-[24px_40px] max-lg:flex max-lg:flex-col max-lg:gap-6 max-sm:p-[24px_20px]", className)}>
  <Link href="/" class={style({}, __props, { label: "Logo" })} aria-label="Home"><span class={style({}, __props, { label: "LogoText" }) + " text-text text-[18px] font-[700] tracking-[-0.02em]"}>{brandName}</span></Link>
  <ul class={style({}, __props, { label: "FooterLinks" }) + " flex items-center gap-2 max-sm:flex-col max-sm:gap-[0]"}>
    {list(links).map((link, linkIndex) => (
      <NavLink text={link.text} link={{ href: link.href }} />
    ))}
  </ul>
  <div class="text-right max-lg:text-center"><Text size="small" text={copyright} align="inherit" /></div>
</footer>
