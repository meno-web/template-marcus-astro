---
import { list, resolveProps, style } from 'meno-astro';
import { Link } from 'meno-astro/components';
import NavLink from './NavLink.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  brandName: { type: "string", default: "Starter" },
  links: {
    type: "list",
    itemSchema: {
      text: { type: "string", default: "Link" },
      href: { type: "link", default: "/" }
    },
    default: [
      { text: "Features", href: "#features" },
      { text: "About", href: "#about" },
      { text: "Contact", href: "#contact" }
    ]
  },
  copyright: { type: "string", default: "© 2026 Starter. All rights reserved." },
  theme: { type: "select", default: "light", enumName: "theme" }
});
const { brandName, links, copyright, theme, class: className } = __props;
---
<footer class={style({
    base: {
      display: "grid",
      gridTemplateColumns: "1fr auto 1fr",
      alignItems: "center",
      padding: "32px 80px",
      backgroundColor: "var(--bg)",
      borderTop: "1px solid",
      borderColor: "var(--border)"
    },
    tablet: {
      padding: "24px 40px",
      display: "flex",
      flexDirection: "column",
      gap: "24px"
    },
    mobile: { padding: "24px 20px" }
  }, __props, { root: true, label: "Footer" })}>
  <Link href="/" class={style({}, __props, { label: "Logo" })} aria-label="Home">
    <span class={style({
        base: {
          color: "var(--text)",
          fontSize: "18px",
          fontWeight: "700",
          letterSpacing: "-0.02em"
        },
        tablet: {},
        mobile: {}
      }, __props, { label: "LogoText" })}>{brandName}</span>
  </Link>
  <ul class={style({
      base: { display: "flex", alignItems: "center", gap: "8px" },
      tablet: {},
      mobile: { flexDirection: "column", gap: "0" }
    }, __props, { label: "FooterLinks" })}>
    {list(links).map((link, linkIndex) => (
      <NavLink text={link.text} link={{ href: link.href }} />
    ))}
  </ul>
  <div class={style({ base: { textAlign: "right" }, tablet: { textAlign: "center" }, mobile: {} }, __props)}><Text size="small" text={copyright} align="inherit" /></div>
</footer>
