---
import { cx, href, resolveProps, style } from 'meno-astro';
import { Link } from 'meno-astro/components';

const __props = resolveProps(Astro, {
  text: { type: "string", default: "Link" },
  link: { type: "link" }
});
const { text, link, class: className } = __props;
---
<li class={cx("[list-style:none]", className)}>
  <Link href={href({ _mapping: true, prop: "link", values: {} }, __props)} class={style({}, __props, {
      interactive: [
        {
          name: "hover",
          prefix: "",
          postfix: ":hover",
          style: { base: { backgroundColor: "var(--bg-100)" } }
        }
      ]
    }) + " p-[10px_16px] block text-text rounded-[4px] no-underline cursor-pointer transition-[background_0.2s] max-lg:p-[10px_16px]"}>{text}</Link>
</li>
