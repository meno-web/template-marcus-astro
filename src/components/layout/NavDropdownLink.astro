---
import { href, resolveProps, style } from 'meno-astro';
import { Link } from 'meno-astro/components';

const __props = resolveProps(Astro, {
  text: { type: "string", default: "Link" },
  link: { type: "link" }
});
const { text, link, class: className } = __props;
---
<li class={style({ base: { listStyle: "none" } }, __props, { root: true })}>
  <Link href={href({ _mapping: true, prop: "link", values: {} }, __props)} class={style({
      base: {
        color: "var(--text)",
        textDecoration: "none",
        display: "block",
        padding: "10px 16px",
        borderRadius: "4px",
        transition: "background 0.2s",
        cursor: "pointer"
      },
      tablet: { padding: "10px 16px" },
      mobile: {}
    }, __props, {
      interactive: [
        {
          name: "hover",
          prefix: "",
          postfix: ":hover",
          style: { base: { backgroundColor: "var(--bg-100)" } }
        }
      ]
    })}>{text}</Link>
</li>
