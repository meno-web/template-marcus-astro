---
import { cx, resolveProps, style } from 'meno-astro';
import Banner from './Banner.astro';
import FooterMultiColumn from './FooterMultiColumn.astro';
import Modal from '../ui/Modal.astro';
import Navigation from './Navigation.astro';

const __props = resolveProps(Astro, {});
const { class: className } = __props;
---
<div class={cx("bg-bg font-(--l-ff)", className)} theme="dark" data-theme-root="true">
  <Banner text="Currently booking for 2026 — Get in touch to discuss your project" variant="default" isDismissible={true} />
  <Navigation isOpen={false} />
  <main class={style({}, __props, { label: "main" })}><slot /></main>
  <FooterMultiColumn brandName="Marcus Cole" tagline="Filmmaker & Cinematographer" column1Title="Work" column1Links={[
      { text: "Filmography", href: { href: "/work" } },
      { text: "Commercials", href: "/" },
      { text: "Music Videos", href: "/" }
    ]} column2Title="Info" column2Links={[
      { text: "Process", href: "/" },
      { text: "About", href: { href: "/about" } },
      { text: "Equipment", href: "/" }
    ]} column3Title="Connect" column3Links={[
      { text: "Contact", href: "#contact" },
      { text: "Instagram", href: "/" },
      { text: "Vimeo", href: "/" }
    ]} copyright="© 2026 Marcus Cole. All rights reserved." theme="dark" />
  <Modal modalId="reel" isOpen={false}><div data-video-src="https://www.youtube.com/embed/-3upUXFbB6c?autoplay=1" class="w-[90vw] max-w-[960px] aspect-[16/9] bg-[#000] rounded-[8px] relative overflow-hidden" /></Modal>
</div>
