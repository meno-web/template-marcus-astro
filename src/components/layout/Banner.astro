---
import { resolveProps, style, when } from 'meno-astro';
import Icon from '../ui/Icon.astro';

const __props = resolveProps(Astro, {
  text: {
    type: "rich-text",
    default: "Currently booking for 2026 — Get in touch to discuss your project"
  },
  variant: {
    type: "select",
    default: "default",
    options: ["default", "primary"]
  },
  isDismissible: { type: "boolean", default: true }
});
const { text, variant, isDismissible, class: className } = __props;
---
<div class={style({
    base: {
      display: "flex",
      alignItems: "center",
      justifyContent: "center",
      gap: "12px",
      padding: "10px 80px",
      fontSize: "var(--ts-fs)",
      textAlign: "center",
      backgroundColor: {
        _mapping: true,
        prop: "variant",
        values: { default: "var(--bg-100)", primary: "var(--primary)" }
      },
      color: {
        _mapping: true,
        prop: "variant",
        values: { default: "var(--text)", primary: "#fff" }
      },
      position: "relative",
      zIndex: "101"
    },
    tablet: { padding: "10px 40px" },
    mobile: { padding: "10px 20px" }
  }, __props, { root: true, label: "banner" })}>
  <span class={style({}, __props, { label: "text" })}><Fragment set:html={text} /></span>
  {when({ _mapping: true, prop: "isDismissible", values: { true: true, false: false } }, __props) && (
    <button class={style({
        base: {
          background: "none",
          border: "none",
          cursor: "pointer",
          color: "inherit",
          padding: "4px",
          display: "flex",
          alignItems: "center"
        }
      }, __props, {
        interactive: [
          {
            name: "on hover",
            postfix: ":hover",
            style: { base: { opacity: "0.7" } }
          }
        ],
        label: "close button"
      })} data-el="close-btn"><Icon icon="x" size={16} /></button>
  )}
</div>


<script define:vars={{ text, variant, isDismissible }}>
(function(el, props){
const closeBtn = el.querySelector('[data-el="close-btn"]');
if (closeBtn) {
  closeBtn.addEventListener('click', function () {
    el.style.display = 'none';
  });
}
})((function(){var s=document.currentScript,e=s&&s.previousElementSibling;while(e&&(e.nodeName==='STYLE'||e.nodeName==='SCRIPT'))e=e.previousElementSibling;return e||null;})(), { text, variant, isDismissible });
</script>