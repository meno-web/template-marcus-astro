---
import { cx, resolveProps, richTextWithComponents, style, variants, when } from 'meno-astro';
import Icon from '../ui/Icon.astro';
import { cmsComponents } from '../../cmsComponents';

const __props = resolveProps(Astro, {
  text: {
    type: "rich-text",
    default: "Currently booking for 2026 — Get in touch to discuss your project"
  },
  variant: {
    type: "select",
    default: "default",
    options: ["default", "primary"]
  },
  isDismissible: { type: "boolean", default: true }
});
const { text, variant, isDismissible, class: className } = __props;
---
<div class={cx(style({ base: {} }, __props, { label: "banner" }), variants(__props, {
    variant: {
      default: "bg-[var(--bg-100)] text-(--text)",
      primary: "bg-(--primary) text-[#fff]"
    }
  }), "p-[10px_80px] flex justify-center items-center gap-3 text-(length:--ts-fs) text-center relative z-101 max-lg:p-[10px_40px] max-sm:p-[10px_20px]", className)}>
  <span class={style({}, __props, { label: "text" })}><Fragment set:html={richTextWithComponents(text, cmsComponents)} /></span>
  {when({ _mapping: true, prop: "isDismissible", values: { true: true, false: false } }, __props) && (
    <button class={style({}, __props, {
        interactive: [
          {
            name: "on hover",
            postfix: ":hover",
            style: { base: { opacity: "0.7" } }
          }
        ],
        label: "close button"
      }) + " p-1 flex items-center [background:none] text-inherit border-[none] cursor-pointer"} data-el="close-btn"><Icon icon="x" size={16} /></button>
  )}
</div>


<script define:vars={{ text, variant, isDismissible }}>
(function(el, props){
const closeBtn = el.querySelector('[data-el="close-btn"]');
if (closeBtn) {
  closeBtn.addEventListener('click', function () {
    el.style.display = 'none';
  });
}
})((function(){var s=document.currentScript,e=s&&s.previousElementSibling;while(e&&(e.nodeName==='STYLE'||e.nodeName==='SCRIPT'))e=e.previousElementSibling;return e||null;})(), { text, variant, isDismissible });
</script>