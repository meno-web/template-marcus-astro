---
import { resolveProps, style } from 'meno-astro';
import { Link } from 'meno-astro/components';
import Button from '../ui/Button.astro';
import NavLink from './NavLink.astro';

const __props = resolveProps(Astro, {
  isOpen: { type: "boolean", default: false }
});
const { isOpen, class: className } = __props;
---
<nav class={style({
    base: {
      display: "flex",
      alignItems: "center",
      justifyContent: "center",
      margin: "0 auto",
      position: "sticky",
      top: "0",
      backgroundColor: "var(--bg)",
      zIndex: "100"
    },
    tablet: {},
    mobile: {}
  }, __props, { root: true, label: "Nav" })}>
  <Container class={style({
      base: {
        display: "flex",
        alignItems: "center",
        justifyContent: "space-between",
        width: "100%",
        maxWidth: "var(--c-s)",
        padding: "0 80px"
      },
      tablet: { padding: "0px 40px", height: "var(--n-s)" },
      mobile: { padding: "0 20px" }
    }, __props)}>
    <input class={style({ base: { display: "none" }, tablet: {}, mobile: {} }, __props, { label: "MenuToggle" })} type="checkbox" id="menu-toggle" />
    <Link href="/" aria-label="Home">
      <span class={style({
          base: {
            color: "var(--text)",
            fontSize: "20px",
            fontWeight: "700",
            letterSpacing: "-0.02em"
          },
          tablet: {},
          mobile: {}
        }, __props, { label: "Logo" })}>Marcus Cole</span>
    </Link>
    <label class={style({
        base: { display: "none", cursor: "pointer" },
        tablet: {
          display: "flex",
          flexDirection: "column",
          gap: "4px",
          width: "28px",
          height: "24px",
          justifyContent: "center",
          zIndex: "101",
          marginLeft: "auto"
        },
        mobile: {}
      }, __props, { label: "HamburgerButton" })} for="menu-toggle" aria-label="Toggle menu">
      <span class={style({
          base: { display: "none" },
          tablet: {
            display: "block",
            width: "100%",
            height: "2px",
            backgroundColor: "var(--text)",
            transition: "all 0.3s ease"
          },
          mobile: {}
        }, __props, {
          interactive: [
            {
              prefix: "#menu-toggle:checked ~ label[for=\"menu-toggle\"] ",
              postfix: ":nth-child(1)",
              style: {
                base: { transform: "rotate(45deg) translate(2.5px, 2.5px)" },
                tablet: {},
                mobile: {}
              }
            }
          ],
          label: "Line1"
        })} />
      <span class={style({
          base: { display: "none" },
          tablet: {
            display: "block",
            width: "100%",
            height: "2px",
            backgroundColor: "var(--text)",
            transition: "all 0.3s ease"
          },
          mobile: {}
        }, __props, {
          interactive: [
            {
              prefix: "#menu-toggle:checked ~ label[for=\"menu-toggle\"] ",
              postfix: ":nth-child(2)",
              style: {
                base: { transform: "rotate(-45deg) translate(2.5px, -2.5px)" },
                tablet: {},
                mobile: {}
              }
            }
          ],
          label: "Line2"
        })} />
    </label>
    <div class={style({
        base: { display: "flex", alignItems: "center", gap: "16px" },
        tablet: {
          position: "absolute",
          top: "var(--n-s)",
          left: "0",
          width: "100%",
          height: "calc(100vh - 65px)",
          flexDirection: "column",
          padding: "20px 20px",
          backgroundColor: "var(--bg)",
          zIndex: "99",
          transition: "opacity 0.3s ease, visibility 0.3s ease",
          alignItems: "flex-start",
          gap: "24px",
          overflow: "auto",
          opacity: "0",
          visibility: "hidden",
          pointerEvents: "none"
        },
        mobile: { padding: "10px 0" }
      }, __props, {
        interactive: [
          {
            name: "on Open",
            prefix: "#menu-toggle:checked ~",
            style: {
              base: {},
              tablet: { opacity: "1", visibility: "visible", pointerEvents: "auto" },
              mobile: {}
            },
            previewProp: "isOpen"
          }
        ],
        label: "NavList"
      })}>
      <ul class={style({
          base: { display: "flex", alignItems: "center", justifyContent: "center" },
          tablet: { flexDirection: "column", alignItems: "flex-start", gap: "0" },
          mobile: { flexDirection: "column", alignItems: "flex-start" }
        }, __props, { label: "NavLinks" })}>
        <NavLink text="Work" link={{ href: "/work" }} />
        <NavLink text="About" link={{ href: "/about" }} />
        <NavLink text="Contact" link={{ href: "/contact" }} />
      </ul>
      <div class={style({ base: {}, tablet: { paddingLeft: "16px" }, mobile: {} }, __props)}><div open-modal="reel"><Button isMarginTop={false} text="Watch the reel" variant="primary" link="" /></div></div>
    </div>
  </Container>
  <label class={style({
      base: { display: "none", cursor: "pointer" },
      tablet: {
        display: "none",
        position: "fixed",
        top: "0",
        left: "0",
        width: "100%",
        height: "100%",
        backgroundColor: "rgba(0, 0, 0, 0.5)",
        zIndex: "998",
        transition: "opacity 0.3s ease",
        opacity: "0",
        pointerEvents: "none"
      },
      mobile: {
        display: "none",
        position: "fixed",
        top: "0",
        left: "0",
        width: "100%",
        height: "100%",
        backgroundColor: "rgba(0, 0, 0, 0.5)",
        zIndex: "998",
        transition: "opacity 0.3s ease",
        opacity: "0",
        pointerEvents: "none"
      }
    }, __props, {
      interactive: [
        {
          prefix: "#menu-toggle:checked ~ ",
          postfix: " ",
          style: {
            base: { opacity: "1", pointerEvents: "auto" },
            tablet: {},
            mobile: {}
          }
        }
      ],
      label: "MobileOverlay"
    })} for="menu-toggle" data-mobile-overlay="" />
</nav>
