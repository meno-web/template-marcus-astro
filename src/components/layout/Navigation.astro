---
import { cx, resolveProps, style } from 'meno-astro';
import { Link } from 'meno-astro/components';
import Button from '../ui/Button.astro';
import NavLink from './NavLink.astro';

const __props = resolveProps(Astro, {
  isOpen: { type: "boolean", default: false }
});
const { isOpen, class: className } = __props;
---
<nav class={cx(style({}, __props, { label: "Nav" }), "m-[0_auto] flex justify-center items-center bg-bg sticky top-[0] z-100", className)}>
  <container class="p-[0_80px] flex justify-between items-center w-full max-w-(--c-s) max-lg:p-[0px_40px] max-lg:h-(--n-s) max-sm:p-[0_20px]">
    <input class={style({}, __props, { label: "MenuToggle" }) + " hidden"} type="checkbox" id="menu-toggle" />
    <Link href="/" aria-label="Home"><span class={style({}, __props, { label: "Logo" }) + " text-text text-[20px] font-[700] tracking-[-0.02em]"}>Marcus Cole</span></Link>
    <label class={style({}, __props, { label: "HamburgerButton" }) + " hidden cursor-pointer max-lg:ml-auto max-lg:flex max-lg:flex-col max-lg:justify-center max-lg:gap-1 max-lg:w-7 max-lg:h-6 max-lg:z-101"} for="menu-toggle" aria-label="Toggle menu">
      <span class={style({}, __props, {
          interactive: [
            {
              prefix: "#menu-toggle:checked ~ label[for=\"menu-toggle\"] ",
              postfix: ":nth-child(1)",
              style: {
                base: { transform: "rotate(45deg) translate(2.5px, 2.5px)" },
                tablet: {},
                mobile: {}
              }
            }
          ],
          label: "Line1"
        }) + " hidden max-lg:block max-lg:w-full max-lg:h-0.5 max-lg:bg-text max-lg:transition-[all_0.3s_ease]"} />
      <span class={style({}, __props, {
          interactive: [
            {
              prefix: "#menu-toggle:checked ~ label[for=\"menu-toggle\"] ",
              postfix: ":nth-child(2)",
              style: {
                base: { transform: "rotate(-45deg) translate(2.5px, -2.5px)" },
                tablet: {},
                mobile: {}
              }
            }
          ],
          label: "Line2"
        }) + " hidden max-lg:block max-lg:w-full max-lg:h-0.5 max-lg:bg-text max-lg:transition-[all_0.3s_ease]"} />
    </label>
    <div class={style({}, __props, {
        interactive: [
          {
            name: "on Open",
            prefix: "#menu-toggle:checked ~",
            style: {
              base: {},
              tablet: { opacity: "1", visibility: "visible", pointerEvents: "auto" },
              mobile: {}
            },
            previewProp: "isOpen"
          }
        ],
        label: "NavList"
      }) + " flex items-center gap-4 max-lg:p-[20px_20px] max-lg:flex-col max-lg:items-start max-lg:gap-6 max-lg:w-full max-lg:h-[calc(100vh_-_65px)] max-lg:bg-bg max-lg:opacity-0 max-lg:absolute max-lg:top-(--n-s) max-lg:left-[0] max-lg:z-99 max-lg:overflow-auto max-lg:pointer-events-none max-lg:transition-[opacity_0.3s_ease,_visibility_0.3s_ease] max-lg:invisible max-sm:p-[10px_0]"}>
      <ul class={style({}, __props, { label: "NavLinks" }) + " flex justify-center items-center max-lg:flex-col max-lg:items-start max-lg:gap-[0] max-sm:flex-col max-sm:items-start"}>
        <NavLink text="Work" link={{ href: "/work" }} />
        <NavLink text="About" link={{ href: "/about" }} />
        <NavLink text="Contact" link={{ href: "/contact" }} />
      </ul>
      <div class="max-lg:pl-4"><div open-modal="reel"><Button isMarginTop={false} text="Watch the reel" variant="primary" link="" /></div></div>
    </div>
  </container>
  <label class={style({}, __props, {
      interactive: [
        {
          prefix: "#menu-toggle:checked ~ ",
          postfix: " ",
          style: {
            base: { opacity: "1", pointerEvents: "auto" },
            tablet: {},
            mobile: {}
          }
        }
      ],
      label: "MobileOverlay"
    }) + " hidden cursor-pointer max-lg:hidden max-lg:w-full max-lg:h-full max-lg:bg-[rgba(0,_0,_0,_0.5)] max-lg:opacity-0 max-lg:fixed max-lg:top-[0] max-lg:left-[0] max-lg:z-998 max-lg:pointer-events-none max-lg:transition-[opacity_0.3s_ease] max-sm:hidden max-sm:w-full max-sm:h-full max-sm:bg-[rgba(0,_0,_0,_0.5)] max-sm:opacity-0 max-sm:fixed max-sm:top-[0] max-sm:left-[0] max-sm:z-998 max-sm:pointer-events-none max-sm:transition-[opacity_0.3s_ease]"} for="menu-toggle" data-mobile-overlay="" />
</nav>
