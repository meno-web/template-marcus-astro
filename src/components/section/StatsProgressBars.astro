---
import { list, resolveProps, style } from 'meno-astro';
import Grid from '../ui/Grid.astro';
import Heading from '../ui/Heading.astro';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Subtitle from '../ui/Subtitle.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  subtitle: { type: "string", default: "Performance" },
  title: { type: "rich-text", default: "Our achievements at a glance" },
  text: {
    type: "rich-text",
    default: "Track record of excellence across key metrics."
  },
  isCenter: { type: "boolean", default: false },
  items: {
    type: "list",
    itemSchema: {
      label: { type: "string", default: "Metric" },
      value: { type: "number", default: 75 },
      description: { type: "string", default: "" }
    },
    default: [
      {
        label: "Customer Satisfaction",
        value: 95,
        description: "Based on annual surveys"
      },
      {
        label: "Project Success Rate",
        value: 88,
        description: "Projects delivered on time and budget"
      },
      {
        label: "Team Retention",
        value: 92,
        description: "Year-over-year retention"
      }
    ]
  },
  theme: { type: "select", default: "primary", enumName: "theme" }
});
const {
  subtitle,
  title,
  text,
  isCenter,
  items,
  theme,
  class: className,
} = __props;
---
<Section theme={theme} spaceTop="default" class={style({}, __props, { root: true })}>
  <SectionHeader isCenter={isCenter} maxWidth="">
    {subtitle && (
      <Subtitle text={subtitle} fade="0" align={{
          _mapping: true,
          prop: "isCenter",
          values: { default: "left", true: "center", false: "left" }
        }} />
    )}
    <Heading text={title} maxWidth="640px" fade="0.2" align={{
        _mapping: true,
        prop: "isCenter",
        values: { default: "left", true: "center", false: "left" }
      }} size="2" tag="2" />
    {text && (
      <Text text={text} size="large" fade="0.4" align={{
          _mapping: true,
          prop: "isCenter",
          values: { default: "left", true: "center", false: "left" }
        }} maxWidth="580px" />
    )}
  </SectionHeader>
  <Grid columns="1" gap="24" fade="0.4">
    {list(items).map((item, itemIndex) => (
      <div class={style({
          base: {
            display: "flex",
            flexDirection: "column",
            gap: "8px",
            marginBottom: "24px"
          }
        }, __props, { label: "Stat Item" })}>
        <div class={style({
            base: {
              display: "flex",
              justifyContent: "space-between",
              alignItems: "center"
            }
          }, __props, { label: "Label Row" })}>
          <Text text={item.label} weight="semibold" />
          <Heading text={item.value} size="5" tag="3" color="primary" />
        </div>
        <div class={style({
            base: {
              width: "100%",
              height: "8px",
              backgroundColor: "var(--bg-100)",
              borderRadius: "4px",
              overflow: "hidden"
            }
          }, __props, { label: "Progress Bar Background" })}>
          <div class={style({
              base: {
                width: "{{item.value}}%",
                height: "100%",
                backgroundColor: "var(--text)",
                borderRadius: "4px",
                transition: "width 0.3s ease"
              },
              tablet: {},
              mobile: {}
            }, __props, { label: "Progress Bar Fill" })} style={`--m-base-width: ${item.value}%`} />
        </div>
        {item.description && (
          <Text text={item.description} size="small" color="light" />
        )}
      </div>
    ))}
  </Grid>
</Section>
