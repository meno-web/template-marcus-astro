---
import { cx, list, resolveProps, style, variants } from 'meno-astro';
import { Embed } from 'meno-astro/components';
import Grid from '../ui/Grid.astro';
import Heading from '../ui/Heading.astro';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Subtitle from '../ui/Subtitle.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  subtitle: { type: "string", default: "Our impact" },
  title: { type: "rich-text", default: "Numbers that speak for themselves" },
  text: {
    type: "rich-text",
    default: "We're proud of the results we've achieved together with our clients."
  },
  isCenter: { type: "boolean", default: false },
  columns: { type: "select", default: "3", options: ["2", "3", "4"] },
  showAccent: { type: "boolean", default: true },
  items: {
    type: "list",
    itemSchema: {
      value: { type: "string", default: "100+" },
      label: { type: "string", default: "Label" },
      description: { type: "string", default: "" },
      icon: { type: "string", default: "" }
    },
    default: [
      {
        value: "500+",
        label: "Projects Delivered",
        description: "Successfully completed projects across various industries",
        icon: "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"/><polyline points=\"22 4 12 14.01 9 11.01\"/></svg>"
      },
      {
        value: "98%",
        label: "Client Retention",
        description: "Clients who continue working with us year after year",
        icon: "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"/><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"/></svg>"
      },
      {
        value: "15+",
        label: "Years of Experience",
        description: "Building expertise and delivering excellence since day one",
        icon: "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><polyline points=\"12 6 12 12 16 14\"/></svg>"
      }
    ]
  },
  theme: { type: "select", default: "primary", enumName: "theme" }
});
const {
  subtitle,
  title,
  text,
  isCenter,
  columns,
  showAccent,
  items,
  theme,
  class: className,
} = __props;
---
<Section theme={theme} spaceTop="default" class={style({}, __props, { root: true })}>
  <SectionHeader isCenter={isCenter} maxWidth="">
    {subtitle && (
      <Subtitle text={subtitle} align={{
          _mapping: true,
          prop: "isCenter",
          values: { default: "left", true: "center", false: "left" }
        }} fade="0" />
    )}
    <Heading text={title} maxWidth="640px" align={{
        _mapping: true,
        prop: "isCenter",
        values: { default: "left", true: "center", false: "left" }
      }} size="2" tag="2" fade="0.2" />
    {text && (
      <Text text={text} size="large" align={{
          _mapping: true,
          prop: "isCenter",
          values: { default: "left", true: "center", false: "left" }
        }} maxWidth="580px" fade="0.4" />
    )}
  </SectionHeader>
  <Grid columns={columns} gap="24" fade="0.4">
    {list(items).map((item, itemIndex) => (
      <div class={cx(style({ base: {} }, __props, { label: "Stat Card" }), variants(__props, {
          showAccent: {
            default: "border-l-[4px_solid_var(--primary)]",
            true: "border-l-[4px_solid_var(--primary)]",
            false: "border-l-[none]"
          }
        })) + " p-8 flex flex-col items-start bg-[var(--bg-100)] rounded-[12px]"}>
        {item.icon && (
          <div class={style({}, __props, { label: "Icon Wrap" }) + " mb-4 w-12 h-12"}><Embed html={item.icon} class={style({}, __props, { label: "Icon" }) + " h-12 text-primary"} /></div>
        )}
        <Heading text={item.value} size="2" tag="3" />
        <Text text={item.label} weight="semibold" />
        {item.description && (
          <Text text={item.description} size="small" color="secondary" />
        )}
      </div>
    ))}
  </Grid>
</Section>
