---
import { getCollection } from 'astro:content';
import { getCollectionList, i18n, resolveProps, style } from 'meno-astro';
import { Embed, Link, MenoImage } from 'meno-astro/components';
import Grid from '../ui/Grid.astro';
import Heading from '../ui/Heading.astro';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Subtitle from '../ui/Subtitle.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  subtitle: { type: "string", default: "Portfolio" },
  title: { type: "rich-text", default: "Our recent work" },
  text: {
    type: "rich-text",
    default: "Explore some of our latest projects and see what we can create for you."
  },
  theme: { type: "select", default: "primary", enumName: "theme" }
});
const { subtitle, title, text, theme, class: className } = __props;

const case_studiesList = await getCollectionList("case-studies", { sort: { field: "publishedAt", direction: "desc" } }, Astro, getCollection);
---
<Section theme={theme} spaceTop="default" class={style({}, __props, { root: true })}>
  <SectionHeader isCenter={true} maxWidth="600px">
    {subtitle && (
      <Subtitle text={subtitle} align="center" fade="0" />
    )}
    <Heading text={title} maxWidth="" align="center" size="2" tag="2" fade="0.2" />
    {text && (
      <Text text={text} size="large" align="center" maxWidth="" fade="0.4" />
    )}
  </SectionHeader>
  <Grid columns="2" gap="24" fade="0.4">
    {case_studiesList.map((study, studyIndex) => (
      <Link href={`/work/${i18n(study.slug)}`} class={style({}, __props, {
          interactive: [
            {
              prefix: "",
              postfix: ":hover [data-el='overlay']",
              style: { base: { opacity: "1" } }
            },
            {
              postfix: ":hover",
              style: { base: { borderRadius: "40px", cursor: "pointer" } }
            },
            {
              postfix: ":hover [data-el='cursor']",
              style: { base: { opacity: "1" } }
            }
          ],
          label: "Item"
        }) + " block aspect-[4/3] text-inherit rounded-[12px] no-underline relative overflow-hidden transition-[border-radius_.2s]"}>
        <MenoImage src={i18n(study.image) || undefined} alt={i18n(study.title) || undefined} class="w-full h-full transition-[transform_0.3s_ease] object-cover" />
        <div data-el="overlay" class="p-6 [background:linear-gradient(transparent,_rgba(0,0,0,0.7))] opacity-0 absolute right-[0] bottom-[0] left-[0] transition-[opacity_0.3s_ease]">
          <h3 class="m-[0_0_4px_0] text-[#ffffff] text-[18px] font-[600]">{i18n(study.title)}</h3>
          <p class="m-[0] text-[rgba(255,255,255,0.7)] text-[14px]">{i18n(study.category)}</p>
        </div>
        <div data-el="cursor" class="flex justify-center items-center w-[72px] h-[72px] bg-accent rounded-[50%] opacity-0 transform-[translate(-50%,_-50%)] absolute top-[0] left-[0] z-10 pointer-events-none transition-[opacity_0.2s]"><Embed html={`<svg width='20' height='20' viewBox='0 0 16 16' fill='none' xmlns='http://www.w3.org/2000/svg'><path d='M3 8H13M13 8L8.5 3.5M13 8L8.5 12.5' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/></svg>`} class="h-[19px] text-[var(--black)] transform-[rotate(-45deg)]" /></div>
      </Link>
    ))}
  </Grid>
</Section>


<script define:vars={{ subtitle, title, text, theme }}>
(function(el, props){
var cursors = el.querySelectorAll('[data-el="cursor"]');

cursors.forEach(function(cursor) {
  var card = cursor.parentElement;
  var mouseX = 0, mouseY = 0;
  var cursorX = 0, cursorY = 0;
  var isHovering = false;

  card.addEventListener('mousemove', function(e) {
    var rect = card.getBoundingClientRect();
    mouseX = e.clientX - rect.left;
    mouseY = e.clientY - rect.top;
  });

  card.addEventListener('mouseenter', function(e) {
    var rect = card.getBoundingClientRect();
    mouseX = e.clientX - rect.left;
    mouseY = e.clientY - rect.top;
    cursorX = mouseX;
    cursorY = mouseY;
    isHovering = true;
  });

  card.addEventListener('mouseleave', function() {
    isHovering = false;
  });

  function animate() {
    if (isHovering) {
      cursorX += (mouseX - cursorX) * 0.15;
      cursorY += (mouseY - cursorY) * 0.15;
      cursor.style.left = cursorX + 'px';
      cursor.style.top = cursorY + 'px';
    }
    requestAnimationFrame(animate);
  }
  animate();
});

})((function(){var s=document.currentScript,e=s&&s.previousElementSibling;while(e&&(e.nodeName==='STYLE'||e.nodeName==='SCRIPT'))e=e.previousElementSibling;return e||null;})(), { subtitle, title, text, theme });
</script>