---
import { list, resolveProps, style } from 'meno-astro';
import { MenoImage } from 'meno-astro/components';
import Section from '../ui/Section.astro';
import Spacer from '../ui/Spacer.astro';
import Stack from '../ui/Stack.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  text: { type: "string", default: "Trusted by leading companies" },
  items: {
    type: "list",
    itemSchema: {
      image: { type: "file", default: "/images/placeholder-img.webp" },
      title: { type: "string", default: "Company" }
    },
    default: [
      { image: "/images/placeholder-img.webp", title: "Company 1" },
      { image: "/images/placeholder-img.webp", title: "Company 2" },
      { image: "/images/placeholder-img.webp", title: "Company 3" },
      { image: "/images/placeholder-img.webp", title: "Company 4" },
      { image: "/images/placeholder-img.webp", title: "Company 5" }
    ]
  },
  theme: { type: "select", default: "primary", enumName: "theme" }
});
const { text, items, theme, class: className } = __props;
---
<Section theme={theme} class={style({}, __props, { root: true })}>
  <Stack vertical="top" horizontal="center">
    {text && (
      <Text text={text} size="default" align="center" maxWidth="100%" isMarginBottom={true} fade="0" />
    )}
  </Stack>
  <Spacer size="32" />
  <div fade={0.2} class="flex justify-center items-center gap-10">
    {list(items).map((item, itemIndex) => (
      <MenoImage src={item.image || undefined} alt={item.title || undefined} class="w-auto h-8 opacity-60 transition-[opacity_0.2s_ease] hover:opacity-100" />
    ))}
  </div>
</Section>
