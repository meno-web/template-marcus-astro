---
import { list, resolveProps, style } from 'meno-astro';
import Heading from '../ui/Heading.astro';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Subtitle from '../ui/Subtitle.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  subtitle: { type: "string", default: "How It Works" },
  title: { type: "rich-text", default: "Simple steps to get started" },
  text: {
    type: "rich-text",
    default: "Follow these easy steps to begin your journey with us."
  },
  items: {
    type: "list",
    itemSchema: {
      title: { type: "string", default: "Step title" },
      text: { type: "string", default: "Step description" }
    },
    default: [
      {
        title: "Sign up for free",
        text: "Create your account in seconds. No credit card required to get started."
      },
      {
        title: "Set up your project",
        text: "Configure your workspace and invite your team members to collaborate."
      },
      {
        title: "Customize your workflow",
        text: "Tailor the platform to fit your specific needs and preferences."
      },
      {
        title: "Launch and grow",
        text: "Go live and start achieving your goals with our powerful tools."
      }
    ]
  },
  theme: { type: "select", default: "primary", enumName: "theme" }
});
const { subtitle, title, text, items, theme, class: className } = __props;
---
<Section theme={theme} spaceTop="default" class={style({}, __props, { root: true })}>
  <SectionHeader isCenter={true} maxWidth="600px">
    {subtitle && (
      <Subtitle text={subtitle} align="center" fade="0" />
    )}
    <Heading text={title} maxWidth="" align="center" size="2" tag="2" fade="0.2" />
    {text && (
      <Text text={text} size="large" align="center" maxWidth="" fade="0.4" />
    )}
  </SectionHeader>
  <div class="m-[0_auto] max-w-[700px]">
    {list(items).map((item, itemIndex, itemArr) => (
      <div fade={0.4+0.2*itemIndex || undefined} class="flex gap-6 max-sm:gap-4">
        <div class="flex flex-col items-center shrink-0">
          <div class="flex justify-center items-center w-8 h-8 min-w-8 min-h-8 bg-text text-[#ffffff] rounded-[50%] text-[14px] font-[700]">{itemIndex}</div>
          {!(itemIndex === itemArr.length - 1) && (
            <div class="mt-2 mb-[-8px] flex-1 w-0.5 bg-border" />
          )}
        </div>
        <div class="pb-12 flex-1 min-w-[0]">
          <Heading text={item.title} size="5" tag="3" />
          <Text text={item.text} variant="light" />
        </div>
      </div>
    ))}
  </div>
</Section>
