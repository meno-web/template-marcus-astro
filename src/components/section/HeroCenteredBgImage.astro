---
import { resolveProps, style } from 'meno-astro';
import Button from '../ui/Button.astro';
import ButtonList from '../ui/ButtonList.astro';
import Heading from '../ui/Heading.astro';
import Section from '../ui/Section.astro';
import Stack from '../ui/Stack.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  title: { type: "rich-text", default: "Build something amazing" },
  text: {
    type: "rich-text",
    default: "Create beautiful websites and applications with our powerful platform. Get started in minutes."
  },
  image: {
    type: "file",
    default: "/images/placeholder-img.webp",
    accept: "image/*"
  },
  buttonText: { type: "string", default: "Get started" },
  buttonLink: { type: "link", default: "#" },
  secondaryButtonText: { type: "string", default: "Learn more" },
  secondaryButtonLink: { type: "link", default: "#" },
  theme: { type: "select", default: "dark", enumName: "theme" }
});
const {
  title,
  text,
  image,
  buttonText,
  buttonLink,
  secondaryButtonText,
  secondaryButtonLink,
  theme,
  class: className,
} = __props;
---
<Section theme={theme} backgroundImage={image} class={style({}, __props, { root: true })}>
  <Stack horizontal="center">
    <Heading text={title} tag="1" align="center" size="1" fade="0" />
    {text && (
      <Text text={text} size="large" align="center" maxWidth="640px" variant="default" fade="0.2" />
    )}
    {buttonText && (
      <ButtonList fade="0.4">
        <Button text={buttonText} link={buttonLink} />
        {secondaryButtonText && (
          <Button text={secondaryButtonText} link={secondaryButtonLink} variant="secondary" />
        )}
      </ButtonList>
    )}
  </Stack>
</Section>
