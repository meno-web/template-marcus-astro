---
import { resolveProps, style } from 'meno-astro';
import Form from '../form/Form.astro';
import Heading from '../ui/Heading.astro';
import Input from '../form/Input.astro';
import Section from '../ui/Section.astro';
import Spacer from '../ui/Spacer.astro';
import Stack from '../ui/Stack.astro';
import Submit from '../form/Submit.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  title: { type: "rich-text", default: "Subscribe to our newsletter" },
  text: {
    type: "rich-text",
    default: "Get the latest updates, articles, and resources delivered straight to your inbox."
  },
  placeholderText: { type: "string", default: "Enter your email" },
  buttonText: { type: "string", default: "Subscribe" },
  privacyText: {
    type: "string",
    default: "We respect your privacy. Unsubscribe at any time."
  },
  theme: { type: "select", default: "primary", enumName: "theme" }
});
const {
  title,
  text,
  placeholderText,
  buttonText,
  privacyText,
  theme,
  class: className,
} = __props;
---
<Section theme={theme} spaceTop="default" class={style({}, __props, { root: true })}>
  <Stack vertical="top" horizontal="center">
    <div class="flex flex-col items-center max-w-[600px] text-center">
      <Heading text={title} maxWidth="" align="center" size="2" tag="2" fade="0" />
      {text && (
        <Text text={text} size="large" align="center" maxWidth="460px" isMarginBottom={true} fade="0.2" />
      )}
      <Spacer size="32" />
      <div fade={0.4} class="w-full max-w-[460px]">
        <Form>
          <div class="flex gap-2">
            <Input placeholder={placeholderText} />
            <Submit text={buttonText} />
          </div>
        </Form>
      </div>
      <Spacer size="24" />
      <Text text={privacyText} size="small" variant="light" align="center" fade="0.6" />
    </div>
  </Stack>
</Section>
