---
import { list, resolveProps, style } from 'meno-astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Grid from '../ui/Grid.astro';
import Heading from '../ui/Heading.astro';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Spacer from '../ui/Spacer.astro';
import StatNumber from '../ui/StatNumber.astro';
import Subtitle from '../ui/Subtitle.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  subtitle: { type: "string", default: "Pricing" },
  title: { type: "rich-text", default: "Simple, transparent pricing" },
  text: {
    type: "rich-text",
    default: "Choose the plan that works best for you. No hidden fees."
  },
  items: {
    type: "list",
    itemSchema: {
      title: { type: "string", default: "Plan Name" },
      value: { type: "string", default: "$9" },
      label: { type: "string", default: "/month" },
      text: { type: "rich-text", default: "Feature 1\nFeature 2\nFeature 3" },
      buttonText: { type: "string", default: "Get started" },
      link: { type: "link", default: "#" }
    },
    default: [
      {
        title: "Starter",
        value: "$9",
        label: "/month",
        text: "Up to 5 projects\nBasic analytics\nEmail support\n1 GB storage",
        buttonText: "Get started",
        link: "#"
      },
      {
        title: "Professional",
        value: "$29",
        label: "/month",
        text: "Unlimited projects\nAdvanced analytics\nPriority support\n10 GB storage",
        buttonText: "Get started",
        link: "#"
      },
      {
        title: "Enterprise",
        value: "$99",
        label: "/month",
        text: "Everything in Pro\nCustom integrations\nDedicated support\nUnlimited storage",
        buttonText: "Contact sales",
        link: "#"
      }
    ]
  },
  theme: { type: "select", default: "primary", enumName: "theme" }
});
const { subtitle, title, text, items, theme, class: className } = __props;
---
<Section theme={theme} spaceTop="default" class={style({}, __props, { root: true })}>
  <SectionHeader isCenter={true} maxWidth="600px">
    {subtitle && (
      <Subtitle text={subtitle} align="center" fade="0" />
    )}
    <Heading text={title} maxWidth="" align="center" size="2" tag="2" fade="0.2" />
    {text && (
      <Text text={text} size="large" align="center" maxWidth="" fade="0.4" />
    )}
  </SectionHeader>
  <Grid columns="3" gap="24" fade="0.4">
    {list(items).map((item, itemIndex) => (
      <Card item={item}>
        <div class="flex flex-col h-full">
          <Heading text={item.title} size="5" tag="3" />
          <div class="flex items-baseline gap-1">
            <StatNumber text={item.value} />
            <Text text={item.label} variant="light" size="small" />
          </div>
          <Spacer size="16" />
          <Text text={item.text} variant="light" />
          <Spacer size="32" />
          <div class="flex"><Button text={item.buttonText} link={item.link} variant="primary" /></div>
        </div>
      </Card>
    ))}
  </Grid>
</Section>
