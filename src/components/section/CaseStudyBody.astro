---
import { resolveProps, style } from 'meno-astro';
import { Embed, Link } from 'meno-astro/components';
import Heading from '../ui/Heading.astro';
import Image from '../ui/Image.astro';
import Section from '../ui/Section.astro';
import Spacer from '../ui/Spacer.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  theme: { type: "select", default: "dark", enumName: "theme" },
  backText: { type: "string", default: "Back to Work" },
  backLink: { type: "link", default: "/work" },
  category: { type: "string", default: "Category" },
  title: { type: "rich-text", default: "Case Study" },
  image: {
    type: "file",
    accept: "image/*",
    default: "/images/placeholder-img.webp"
  }
});
const {
  theme,
  backText,
  backLink,
  category,
  title,
  image,
  class: className,
} = __props;
---
<Section theme={theme} cropped={false} class={style({}, __props, { root: true })}>
  <article class="m-[0_auto] max-w-[900px]">
    <header class="mb-10">
      <Link href={backLink} class={style({}, __props, {
          interactive: [
            { postfix: ":hover", style: { base: { color: "var(--text)" } } }
          ]
        }) + " mb-6 inline-flex items-center gap-1.5 text-[var(--text-200)] text-[14px] no-underline transition-[color_0.2s_ease]"}>
        <Embed html={`<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>`} class="h-4" />
        <span>{backText}</span>
      </Link>
      <Text text={category} size="small" variant="lighter" fade="0" />
      <Spacer size="8" />
      <Heading text={title} size="1" tag="1" fade="0.2" />
      <Spacer size="24" />
      <Image aspectRatio="16/9" image={image} rounded="medium" fade="0.4" />
    </header>
    <Spacer size="32" />
    <div class="flex flex-col gap-6"><slot /></div>
  </article>
</Section>
