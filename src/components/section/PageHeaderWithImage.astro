---
import { resolveProps, style } from 'meno-astro';
import Heading from '../ui/Heading.astro';
import Image from '../ui/Image.astro';
import Section from '../ui/Section.astro';
import Spacer from '../ui/Spacer.astro';
import Stack from '../ui/Stack.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  title: { type: "rich-text", default: "Page title" },
  text: {
    type: "rich-text",
    default: "A brief description of this page and what visitors can expect to find here."
  },
  image: {
    type: "file",
    default: "/images/placeholder-img.webp",
    accept: "image/*"
  },
  theme: { type: "select", default: "primary", enumName: "theme" }
});
const { title, text, image, theme, class: className } = __props;
---
<Section theme={theme} spaceTop="default" class={style({}, __props, { root: true })}>
  <Stack vertical="top" horizontal="center">
    <div class="w-full max-w-[900px]"><Image image={image} height="400px" border={false} rounded="large" objectFit="cover" fade="0" /></div>
    <Spacer size="64" />
    <Heading text={title} maxWidth="480px" align="center" size="1" tag="1" variant="default" fade="0.2" />
    {text && (
      <Text text={text} size="large" align="center" maxWidth="580px" isMarginBottom={true} fade="0.4" />
    )}
  </Stack>
</Section>
