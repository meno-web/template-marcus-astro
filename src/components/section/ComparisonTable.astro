---
import { list, resolveProps, style } from 'meno-astro';
import Heading from '../ui/Heading.astro';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Subtitle from '../ui/Subtitle.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  subtitle: { type: "string", default: "Compare" },
  title: { type: "rich-text", default: "Choose the right plan" },
  text: {
    type: "rich-text",
    default: "See how our plans compare and find the perfect fit for your needs."
  },
  column1Title: { type: "string", default: "Basic" },
  column2Title: { type: "string", default: "Pro" },
  items: {
    type: "list",
    itemSchema: {
      title: { type: "string", default: "Feature name" },
      value: { type: "string", default: "-" },
      label: { type: "string", default: "Yes" }
    },
    default: [
      { title: "Number of projects", value: "5", label: "Unlimited" },
      { title: "Team members", value: "2", label: "Unlimited" },
      { title: "Storage", value: "1 GB", label: "100 GB" },
      { title: "Priority support", value: "-", label: "Yes" },
      { title: "Custom integrations", value: "-", label: "Yes" }
    ]
  },
  theme: { type: "select", default: "primary", enumName: "theme" }
});
const {
  subtitle,
  title,
  text,
  column1Title,
  column2Title,
  items,
  theme,
  class: className,
} = __props;
---
<Section theme={theme} spaceTop="default" class={style({}, __props, { root: true })}>
  <SectionHeader isCenter={true} maxWidth="600px">
    {subtitle && (
      <Subtitle text={subtitle} fade="0" align="center" />
    )}
    <Heading text={title} maxWidth="" fade="0.2" align="center" size="2" tag="2" />
    {text && (
      <Text text={text} size="large" fade="0.4" align="center" maxWidth="" />
    )}
  </SectionHeader>
  <div fade={0.4} class="overflow-x-auto">
    <table class="w-full min-w-[500px] [border-collapse:collapse]">
      <thead>
        <tr>
          <th class="p-[16px_24px] text-text-secondary border-b-[2px_solid_var(--border)] text-[14px] font-[600] text-left uppercase tracking-[0.5px]">Feature</th>
          <th class="p-[16px_24px] text-text border-b-[2px_solid_var(--border)] text-[16px] font-[600] text-center">{column1Title}</th>
          <th class="p-[16px_24px] bg-[var(--bg-100)] text-text border-b-[2px_solid_] text-[16px] font-[600] text-center">{column2Title}</th>
        </tr>
      </thead>
      {list(items).map((item, itemIndex) => (
        <tr>
          <td class="p-[16px_24px] text-text border-b-[1px_solid_var(--border-100)] text-[15px]">{item.title}</td>
          <td class="p-[16px_24px] border-b-[1px_solid_var(--border-100)] text-center">{item.value}</td>
          <td class="p-[16px_24px] bg-surface border-b-[1px_solid_var(--border-100)] text-center">{item.label}</td>
        </tr>
      ))}
    </table>
  </div>
</Section>
