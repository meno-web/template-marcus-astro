---
import { list, resolveProps, style } from 'meno-astro';
import Grid from '../ui/Grid.astro';
import Heading from '../ui/Heading.astro';
import Image from '../ui/Image.astro';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Subtitle from '../ui/Subtitle.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  subtitle: { type: "string", default: "Our Team" },
  title: { type: "rich-text", default: "Meet the people behind our success" },
  text: {
    type: "rich-text",
    default: "Our talented team is dedicated to delivering exceptional results."
  },
  items: {
    type: "list",
    itemSchema: {
      image: { type: "file", default: "/images/placeholder-img.webp" },
      title: { type: "string", default: "Name" },
      text: { type: "string", default: "Role" }
    },
    default: [
      {
        image: "/images/placeholder-img.webp",
        title: "Sarah Johnson",
        text: "CEO & Founder"
      },
      {
        image: "/images/placeholder-img.webp",
        title: "Michael Chen",
        text: "CTO"
      },
      {
        image: "/images/placeholder-img.webp",
        title: "Emily Rodriguez",
        text: "Design Lead"
      },
      {
        image: "/images/placeholder-img.webp",
        title: "David Kim",
        text: "Engineering Lead"
      }
    ]
  },
  theme: { type: "select", default: "primary", enumName: "theme" }
});
const { subtitle, title, text, items, theme, class: className } = __props;
---
<Section theme={theme} spaceTop="default" class={style({}, __props, { root: true })}>
  <SectionHeader isCenter={true} maxWidth="600px">
    {subtitle && (
      <Subtitle text={subtitle} align="center" fade="0" />
    )}
    <Heading text={title} maxWidth="" align="center" size="2" tag="2" fade="0.2" />
    {text && (
      <Text text={text} size="large" align="center" maxWidth="" fade="0.4" />
    )}
  </SectionHeader>
  <Grid columns="4" gap="24" fade="0.4">
    {list(items).map((item, itemIndex) => (
      <div class="text-center">
        <div class="mr-auto mb-4 ml-auto w-40 h-40 rounded-[50%] overflow-hidden"><Image image={item.image} alt={item.title} objectFit="cover" width="100%" height="100%" /></div>
        <Heading text={item.title} size="5" tag="3" align="center" />
        <Text text={item.text} size="small" variant="light" align="center" />
      </div>
    ))}
  </Grid>
</Section>
