---
import { cx, list, resolveProps, style, variants } from 'meno-astro';
import { MenoImage } from 'meno-astro/components';
import Section from '../ui/Section.astro';

const __props = resolveProps(Astro, {
  theme: { type: "select", default: "light", enumName: "theme" },
  items: {
    type: "list",
    itemSchema: {
      image: {
        type: "file",
        default: "/images/placeholder-img.webp",
        accept: "image/*"
      },
      alt: { type: "string", default: "Logo" }
    },
    default: [
      { image: "/images/placeholder-img.webp", alt: "Company 1" },
      { image: "/images/placeholder-img.webp", alt: "Company 2" },
      { image: "/images/placeholder-img.webp", alt: "Company 3" },
      { image: "/images/placeholder-img.webp", alt: "Company 4" },
      { image: "/images/placeholder-img.webp", alt: "Company 5" },
      { image: "/images/placeholder-img.webp", alt: "Company 6" }
    ]
  },
  speed: {
    type: "select",
    default: "normal",
    options: ["slow", "normal", "fast"]
  },
  imageHeight: { type: "string", default: "40px" },
  gap: { type: "string", default: "48px" },
  spaceTop: {
    type: "select",
    default: "default",
    options: ["default", "small", "none"]
  },
  spaceBottom: {
    type: "select",
    default: "default",
    options: ["default", "small", "none"]
  }
});
const {
  theme,
  items,
  speed,
  imageHeight,
  gap,
  spaceTop,
  spaceBottom,
  class: className,
} = __props;
---
<Section theme={theme} spaceTop={spaceTop} spaceBottom={spaceBottom} class={style({}, __props, { root: true })}>
  <div class={style({}, __props, { label: "Marquee container" }) + " overflow-hidden"} fade={0}>
    <div class={cx(style({ base: {} }, __props, { label: "Marquee track" }), variants(__props, {
        speed: {
          slow: "[animation-duration:60s]",
          normal: "[animation-duration:30s]",
          fast: "[animation-duration:15s]"
        }
      })) + " flex w-max [animation-name:marquee-scroll] [animation-timing-function:linear] [animation-iteration-count:infinite] hover:[animation-play-state:paused]"} data-el="track">
      <div class={style({ base: { gap: "{{gap}}", paddingRight: "{{gap}}" } }, __props, { label: "List 1" }) + " flex items-center shrink-0"} style={`--m-base-gap: ${gap}; --m-base-padding-right: ${gap}`}>
        {list(items).map((item, itemIndex) => (
          <MenoImage class={style({ base: { height: "{{imageHeight}}" } }, __props) + " w-auto opacity-60 shrink-0 transition-[opacity_0.2s_ease] hover:opacity-100"} style={`--m-base-height: ${imageHeight}`} src={item.image || undefined} alt={item.alt || undefined} />
        ))}
      </div>
      <div class={style({ base: { gap: "{{gap}}", paddingRight: "{{gap}}" } }, __props, { label: "List 2" }) + " flex items-center shrink-0"} style={`--m-base-gap: ${gap}; --m-base-padding-right: ${gap}`}>
        {list(items).map((item, itemIndex) => (
          <MenoImage class={style({ base: { height: "{{imageHeight}}" } }, __props) + " w-auto opacity-60 shrink-0 transition-[opacity_0.2s_ease] hover:opacity-100"} style={`--m-base-height: ${imageHeight}`} src={item.image || undefined} alt={item.alt || undefined} />
        ))}
      </div>
    </div>
  </div>
</Section>


<style is:global>
@keyframes marquee-scroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

</style>