---
import { list, resolveProps, style } from 'meno-astro';
import Section from '../ui/Section.astro';

const __props = resolveProps(Astro, {
  theme: { type: "select", default: "light", enumName: "theme" },
  items: {
    type: "list",
    itemSchema: {
      image: {
        type: "file",
        default: "/images/placeholder-img.webp",
        accept: "image/*"
      },
      alt: { type: "string", default: "Logo" }
    },
    default: [
      { image: "/images/placeholder-img.webp", alt: "Company 1" },
      { image: "/images/placeholder-img.webp", alt: "Company 2" },
      { image: "/images/placeholder-img.webp", alt: "Company 3" },
      { image: "/images/placeholder-img.webp", alt: "Company 4" },
      { image: "/images/placeholder-img.webp", alt: "Company 5" },
      { image: "/images/placeholder-img.webp", alt: "Company 6" }
    ]
  },
  speed: {
    type: "select",
    default: "normal",
    options: ["slow", "normal", "fast"]
  },
  imageHeight: { type: "string", default: "40px" },
  gap: { type: "string", default: "48px" },
  spaceTop: {
    type: "select",
    default: "default",
    options: ["default", "small", "none"]
  },
  spaceBottom: {
    type: "select",
    default: "default",
    options: ["default", "small", "none"]
  }
});
const {
  theme,
  items,
  speed,
  imageHeight,
  gap,
  spaceTop,
  spaceBottom,
  class: className,
} = __props;
---
<Section theme={theme} spaceTop={spaceTop} spaceBottom={spaceBottom} class={style({}, __props, { root: true })}>
  <div class={style({ base: { overflow: "hidden" } }, __props, { label: "Marquee container" })} fade={0}>
    <div class={style({
        base: {
          display: "flex",
          width: "max-content",
          animationName: "marquee-scroll",
          animationTimingFunction: "linear",
          animationIterationCount: "infinite",
          animationDuration: {
            _mapping: true,
            prop: "speed",
            values: { slow: "60s", normal: "30s", fast: "15s" }
          }
        },
        tablet: {},
        mobile: {}
      }, __props, {
        interactive: [
          {
            prefix: "",
            postfix: ":hover",
            style: { base: { animationPlayState: "paused" } }
          }
        ],
        label: "Marquee track"
      })} data-el="track">
      <div class={style({
          base: {
            display: "flex",
            alignItems: "center",
            gap: "{{gap}}",
            flexShrink: "0",
            paddingRight: "{{gap}}"
          }
        }, __props, { label: "List 1" })} style={`--m-base-gap: ${gap}; --m-base-padding-right: ${gap}`}>
        {list(items).map((item, itemIndex) => (
          <img class={style({
              base: {
                height: "{{imageHeight}}",
                width: "auto",
                opacity: "0.6",
                transition: "opacity 0.2s ease",
                flexShrink: "0"
              }
            }, __props, {
              interactive: [
                { prefix: "", postfix: ":hover", style: { base: { opacity: "1" } } }
              ]
            })} style={`--m-base-height: ${imageHeight}`} src={item.image || undefined} alt={item.alt || undefined} />
        ))}
      </div>
      <div class={style({
          base: {
            display: "flex",
            alignItems: "center",
            gap: "{{gap}}",
            flexShrink: "0",
            paddingRight: "{{gap}}"
          }
        }, __props, { label: "List 2" })} style={`--m-base-gap: ${gap}; --m-base-padding-right: ${gap}`}>
        {list(items).map((item, itemIndex) => (
          <img class={style({
              base: {
                height: "{{imageHeight}}",
                width: "auto",
                opacity: "0.6",
                transition: "opacity 0.2s ease",
                flexShrink: "0"
              }
            }, __props, {
              interactive: [
                { prefix: "", postfix: ":hover", style: { base: { opacity: "1" } } }
              ]
            })} style={`--m-base-height: ${imageHeight}`} src={item.image || undefined} alt={item.alt || undefined} />
        ))}
      </div>
    </div>
  </div>
</Section>


<style is:global>
@keyframes marquee-scroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

</style>